# Never build the app's own venv or caches into the image -- uv creates a fresh one.
.venv
__pycache__
**/__pycache__
*.py[cod]
.mypy_cache
.ruff_cache

.git
.github

# Secrets and local data. .env is git-ignored already -- never let it reach an image
# layer either. The database is a volume, not a build artifact.
.env
.env.*
!.env.example
*.db
*.db-wal
*.db-shm
cafeops.db
verify_cap.db

# Not needed at runtime; keeps the build context (and layer diff) small.
docs
web/node_modules
web/dist
*.log
.DS_Store

# Wallet certificates and keys are MOUNTED (./secrets/wallet -> /secrets/wallet:ro), never
# baked into an image layer where `docker history`/a pushed image would expose them.
secrets
# Host-only trees the ops image never reads. site/ itself stays: the wallet reads
# site/web/src/data/info.json (hours on the pass) and `cafeops wallet assets` reads
# site/web/public/brand/. The site has its own image (site/Dockerfile).
media
site/media
site/web/node_modules
site/web/dist
site/web/.astro
site/backend/.venv
**/node_modules
**/.venv
