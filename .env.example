# Copy to .env and fill in. `.env` is git-ignored -- keep it that way. Nothing here
# belongs in an image, a compose file, or a commit (see docs/OPERATIONS.md "secrets").
#
# Every CAFEOPS_* setting maps 1:1 onto a field in cafeops/config.py:Settings (prefix
# CAFEOPS_, case-insensitive); CAFEOPS_WALLET_* onto cafeops/integrations/wallet/config.py;
# CAFEOPS_TRUSTED_PROXIES / CAFEOPS_LOGIN_* onto cafeops/services/auth.py:AuthSettings;
# SITE_* onto site/backend/sashasite/config.py. Nothing here is required to run
# `uv run cafeops seed --demo` against fixtures -- the [REQUIRED ...] markers are about
# what breaks in a REAL deployment, not about what the app will refuse to start without.
#
# ONE RULE FOR BLANKS: an optional setting you are not using stays COMMENTED OUT
# (`# KEY=`), never `KEY=` with nothing after it. A blank value is not "unset": a blank
# number or true/false (e.g. CAFEOPS_TELEGRAM_OWNER_CHAT_ID=) stops every cafeops
# command from starting, and a blank path or URL is read as "." or "".
#
# Generate every secret below with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
#
# -----------------------------------------------------------------------------
# GOING LIVE (docker compose, docs/loyalty/GO-LIVE.md) -- the minimum:
#   CAFEOPS_API_PASSWORD      back-office password                    [REQUIRED]
#   CAFEOPS_DOMAIN            back-office host, e.g. ops.sashascorner.co.uk  [REQUIRED for https]
#   SITE_DOMAIN               public site host, e.g. sashascorner.co.uk      [REQUIRED]
#   CAFEOPS_LOYALTY_QR_KEY    signs every card QR; set once, never change    [REQUIRED]
#   SITE_SERVICE_KEY          joins the back office to the site API          [REQUIRED]
#   SITE_ADMIN_PASSWORD       site admin sign-in bootstrap                   [recommended]
# Everything else is optional and switches one feature on: Telegram, SMTP/Twilio
# (card recovery), Apple/Google Wallet (ids here + files in secrets/wallet/),
# Lightspeed, Swetrix, the agent, off-box backups. `cafeops doctor` reports each one as
# configured / not configured / MISCONFIGURED.
# -----------------------------------------------------------------------------

# =============================================================================
# Domains and public URLs -- read by Caddy and docker-compose.yml
# =============================================================================
# The back office's host. Caddy fetches a Let's Encrypt certificate for it on first
# request. Unset/blank serves the back office on plain http :80 so a fresh checkout can
# be curled immediately -- do not run the café on that. Its DNS must point at the box.
# (Under docker a blank value is safe; for Caddy outside docker leave it commented.)
# CAFEOPS_DOMAIN=ops.sashascorner.co.uk
# [REQUIRED] The public website's host (no scheme, no port). Caddy serves the site,
# /rewards, /c/<card>, /staff and the wallet web service on it, plus www -> apex.
# docker-compose.yml derives every public URL below from it as https://$SITE_DOMAIN.
SITE_DOMAIN=sashascorner.co.uk
# Optional overrides; leave commented and they follow SITE_DOMAIN.
#   SITE_PUBLIC_URL: the site's canonical origin (canonical tags, og:url, sitemap --
#     baked in at `docker compose build`), and the origin the loyalty URLs derive from.
#   CAFEOPS_LOYALTY_PUBLIC_URL: card links, recovery and unsubscribe links, web-card QR.
#   CAFEOPS_WALLET_PUBLIC_URL: pass webServiceURL + image URLs (defaults to the loyalty one).
# All three must be the same https origin, no trailing slash; `cafeops doctor` checks.
# SITE_PUBLIC_URL=https://sashascorner.co.uk
# CAFEOPS_LOYALTY_PUBLIC_URL=https://sashascorner.co.uk
# CAFEOPS_WALLET_PUBLIC_URL=https://sashascorner.co.uk

# =============================================================================
# Database
# =============================================================================
# Swapping SQLite for Postgres later is this line plus an Alembic branch
# (ARCHITECTURE.md 6.5). Docker/systemd deployments override this to point at the
# mounted data volume -- see docker-compose.yml and deploy/systemd/*.service.
CAFEOPS_DATABASE_URL=sqlite+pysqlite:///./cafeops.db
CAFEOPS_SQL_ECHO=false
# The site API shares the same SQLite file (its own site_* tables). Docker sets it;
# outside docker it defaults to the repo-root cafeops.db.
# SITE_DATABASE_URL=sqlite+pysqlite:///./cafeops.db

# =============================================================================
# Locale
# =============================================================================
# Stored timestamps are always UTC (invariant enforced by db/types.UTCDateTime). This
# is only for presentation and for deciding which calendar day a sale belongs to
# (ARCHITECTURE.md 6.4 -- bucketing by local day, not UTC, is load-bearing for the
# weekday forecast).
CAFEOPS_LOCAL_TIMEZONE=Europe/London
# SITE_LOCAL_TIMEZONE=Europe/London

# =============================================================================
# Back office -- single shared password (spec 1, no user management)
# =============================================================================
# [REQUIRED for a real deployment] Unset means the API FAILS CLOSED: every route
# except /api/health answers 503 rather than serving costs and margins to anyone who
# finds the port. That is deliberate (see cafeops/api/security.py and
# docs/OPERATIONS.md "blank screen"), not a bug to work around -- set this before
# anyone but you needs to use it. A password later set in Settings wins over this one;
# `cafeops password reset` falls back to it.
CAFEOPS_API_PASSWORD=
# Peers whose X-Forwarded-For is believed (comma-separated IPs/CIDRs). Docker sets the
# private ranges itself (only Caddy can reach the api); the default suits systemd.
# CAFEOPS_TRUSTED_PROXIES=127.0.0.1,::1
# Sign-in lockout on the back office.
# CAFEOPS_LOGIN_FAILURES_PER_MINUTE=5
# CAFEOPS_LOGIN_FAILURES_PER_HOUR=30

# Menu photo uploads (content-addressed files). Docker sets /media itself.
# CAFEOPS_MEDIA_DIR=./media

# =============================================================================
# Telegram bot -- the owner's daily interface (Russian); loyalty summary + alerts
# =============================================================================
# [REQUIRED to start `cafeops bot-run` / the `bot` service] Both must be set together.
# `bot-run` exits with a clear message rather than polling with no token -- see
# cafeops/bot/app.py:BotNotConfigured. Get the token from @BotFather; get the owner
# chat id by messaging the bot once and reading it off `getUpdates`, or from
# @userinfobot. Unset: the 19:30 loyalty summary and fraud alerts are only logged.
# The site API reads the same two for booking/contact notifications.
# CAFEOPS_TELEGRAM_BOT_TOKEN=123456789:replace-with-the-token-from-BotFather
# CAFEOPS_TELEGRAM_OWNER_CHAT_ID=123456789

# =============================================================================
# Sasha's Corner Rewards (docs/loyalty/CONTRACT.md 7, GO-LIVE.md)
# =============================================================================
# [REQUIRED before the first real member joins] HMAC key for every card QR
# (SC1:<card>:<hmac8>), recovery codes and unsubscribe links. Unset derives a dev key
# from the database URL (cafeops doctor warns). Changing it later makes EVERY printed
# and wallet QR stop scanning -- set it once, back it up with .env, never rotate it.
# At least 32 characters. Generate with the command at the top of this file.
CAFEOPS_LOYALTY_QR_KEY=

# Optional: Lightspeed auto-stamping (SPEC Phase 3). Receipts that name a till customer
# add stamps during the nightly sync / `cafeops loyalty pos-sync`. Needs the four
# CAFEOPS_LIGHTSPEED_* credentials. Leave off until the till attaches customers to sales.
# CAFEOPS_LOYALTY_AUTO_STAMP=false
# A staff stamp on the same card within this many minutes of the receipt means the
# visit was already stamped, so the receipt earns nothing.
# CAFEOPS_LOYALTY_POS_DEDUPE_MINUTES=30

# --- card recovery by email (optional) ----------------------------------------------
# Sends one-time recovery codes and campaign emails. Unset is supported: recovery then
# answers "ask staff" and staff find the member from the scanner. Set host AND from
# (plus user+password if your provider needs auth). Any SMTP provider works, e.g. your
# mail host, Postmark, Mailgun, Brevo; 587 = STARTTLS.
# CAFEOPS_SMTP_HOST=smtp.example.com
# CAFEOPS_SMTP_PORT=587
# CAFEOPS_SMTP_USER=
# CAFEOPS_SMTP_PASSWORD=
# CAFEOPS_SMTP_FROM=hello@sashascorner.co.uk

# --- card recovery by SMS (optional) ------------------------------------------------
# All three from the Twilio console (Account SID starts AC; from number in E.164).
# CAFEOPS_TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# CAFEOPS_TWILIO_AUTH_TOKEN=
# CAFEOPS_TWILIO_FROM_NUMBER=+447700900000

# =============================================================================
# Wallet passes (docs/loyalty/WALLET-SETUP.md) -- both optional, independent
# =============================================================================
# Put the FILES in ./secrets/wallet/ (git-ignored, mounted read-only into api and
# scheduler at /secrets/wallet; readable by uid 1000). Under docker the paths default
# to /secrets/wallet/{pass.pem,pass.key,wwdr.pem,google-sa.json}, so with those names
# you set only the ids. Without the ids nothing is offered and the web card is used.
#
# Apple (99 USD/yr organisation account): Pass Type ID + 10-char Team ID.
# CAFEOPS_WALLET_APPLE_PASS_TYPE_ID=pass.uk.co.sashascorner.rewards
# CAFEOPS_WALLET_APPLE_TEAM_ID=XXXXXXXXXX
# Only outside docker, or with other file names:
# CAFEOPS_WALLET_APPLE_CERT_PATH=/secrets/wallet/pass.pem
# CAFEOPS_WALLET_APPLE_KEY_PATH=/secrets/wallet/pass.key
# CAFEOPS_WALLET_APPLE_WWDR_PATH=/secrets/wallet/wwdr.pem
# Only if pass.key is encrypted:
# CAFEOPS_WALLET_APPLE_KEY_PASSWORD=
# true only for development iPhones; production devices never use the sandbox.
# CAFEOPS_WALLET_APPLE_APNS_USE_SANDBOX=false
#
# Google (free issuer account + service-account JSON key).
# CAFEOPS_WALLET_GOOGLE_ISSUER_ID=3388000000000000000
# CAFEOPS_WALLET_GOOGLE_SERVICE_ACCOUNT_PATH=/secrets/wallet/google-sa.json
# Keep stable once Google approved the class (a new suffix is a new class, re-reviewed).
# CAFEOPS_WALLET_GOOGLE_CLASS_SUFFIX=stamp

# =============================================================================
# Lightspeed Restaurant K-Series -- fixtures-first (ARCHITECTURE.md 0, spec 13.3)
# =============================================================================
# All four optional. Absent credentials is a SUPPORTED state: `cafeops sync` defaults
# to --fixtures and `cafeops info` prints "fixtures only". Nothing touches the live POS
# until all four of client id/secret/refresh token/business id are set (from the
# Lightspeed developer portal / your Lightspeed partner contact).
CAFEOPS_LIGHTSPEED_BASE_URL=https://api.lsk.lightspeed.app/v3
# CAFEOPS_LIGHTSPEED_CLIENT_ID=
# CAFEOPS_LIGHTSPEED_CLIENT_SECRET=
# CAFEOPS_LIGHTSPEED_REFRESH_TOKEN=
# CAFEOPS_LIGHTSPEED_BUSINESS_ID=
CAFEOPS_LIGHTSPEED_RATE_LIMIT_PER_SECOND=5.0
CAFEOPS_LIGHTSPEED_MAX_RETRIES=5

# =============================================================================
# Seed / import
# =============================================================================
# [REQUIRED for `cafeops seed --workbook`/`import-legacy` unless you pass --workbook
# explicitly on the command line] Path to the legacy finance workbook (.xlsx). The
# real file is committed as sashas_corner_finance__LEGACY_.xlsx -- see README.md and
# ARCHITECTURE.md "The workbook" for why that one file and not the two look-alikes
# also present in the repo's history.
CAFEOPS_FINANCE_WORKBOOK_PATH=./sashas_corner_finance__LEGACY_.xlsx

# =============================================================================
# Forecasting knobs (spec 5.3, ARCHITECTURE.md 8C)
# =============================================================================
# Defaults are what Phase 0/1 validated against the seeded scenario. Change these and
# re-read ARCHITECTURE.md 8C first -- alpha in particular controls how strongly a
# single unusual day swings base_daily.
CAFEOPS_EWMA_ALPHA=0.3
CAFEOPS_EWMA_WINDOW_DAYS=28
CAFEOPS_DOW_WINDOW_WEEKS=8
CAFEOPS_DOW_FACTOR_MIN=0.5
CAFEOPS_DOW_FACTOR_MAX=2.0
CAFEOPS_MIN_HISTORY_DAYS=14

# =============================================================================
# Labour and true margin (spec 5.6, answered spec 15.7)
# =============================================================================
# GBP pence per hour, LOADED (wage + employer NI + pension + holiday accrual),
# confirmed with the owner at £14.50/hr. Optional and deliberately so: set it to 0 (or
# delete the line -- a blank value does not parse) and every labour figure,
# true_margin and margin_per_minute in the system becomes None rather than a
# flattering number computed from a guess -- see cafeops/config.py's own comment.
CAFEOPS_LOADED_HOURLY_RATE_PENCE=1450

# =============================================================================
# Channels -- Deliveroo / Just Eat (spec 4.6)
# =============================================================================
# CSV_UPLOAD is the path that works today: the owner has portal logins and exports by
# hand. BROWSER_AGENT drives a browser and falls back to CSV when it breaks (assume it
# will). PARTNER_API is not constructible -- partner APIs are gated to certified POS
# integrators (ARCHITECTURE.md 0). Unset CSV dir uses the shipped fixtures.
CAFEOPS_CHANNEL_SOURCE=CSV_UPLOAD
# CAFEOPS_CHANNEL_CSV_DIR=/data/channels
# CAFEOPS_CHANNEL_BROWSER_DRIVER=fixture

# =============================================================================
# The bounded agent (spec 9) -- narration and browser automation only, never writes
# =============================================================================
# Optional. Absent key is a SUPPORTED state: the narration tool falls back to a
# deterministic template-built sentence rather than refusing to report (invariant 10
# still holds either way -- the agent never writes to stock/orders/composition, key or
# no key). Key from console.anthropic.com > API keys.
# CAFEOPS_ANTHROPIC_API_KEY=
CAFEOPS_AGENT_MODEL=claude-opus-5
CAFEOPS_AGENT_MAX_TOKENS=1200
CAFEOPS_AGENT_MAX_TOOL_CALLS=12

# =============================================================================
# Drift gate (spec 5.2) -- the auto-order trust thresholds
# =============================================================================
# Defaults ARE the spec's own numbers. Do not loosen these to make more ingredients
# auto-order-eligible without re-reading invariant 2: eligibility is earned through
# drift history, never set manually, and these three numbers are what "earned" means.
CAFEOPS_DRIFT_AUTO_ORDER_MAX_PCT=10.0
CAFEOPS_DRIFT_WARN_MAX_PCT=15.0
CAFEOPS_DRIFT_CONSECUTIVE_COUNTS_REQUIRED=2

# =============================================================================
# The public website's API (site/backend, `sashasite`) and its admin
# =============================================================================
# [REQUIRED] One long random value, read by BOTH apps: the back office forwards
# /api/website/* to the site API with it (cafeops/api/areas/website.py). Unset: the
# Website screens (bookings, messages, events, photos) say the site isn't connected.
# Generate with the command at the top of this file.
SITE_SERVICE_KEY=
# Where the back office finds the site API. Docker sets http://site-api:8100 itself.
CAFEOPS_SITE_API_URL=http://127.0.0.1:8100
# [recommended] Bootstrap password for the site's own admin sign-in (/admin on the
# site) until one is set from the admin itself (stored hashed, then it wins). Unset
# and nothing stored: the site admin login answers 503 (fails closed).
SITE_ADMIN_PASSWORD=
# Docker sets SITE_TRUST_PROXY=1 and SITE_MEDIA_DIR=/media itself. The rest are knobs
# with safe defaults:
# SITE_COOKIE_SECURE=false            # Secure admin cookie even over plain http
# SITE_ADMIN_SESSION_DAYS=14
# SITE_LOGIN_RATE_LIMIT_COUNT=5
# SITE_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
# SITE_RATE_LIMIT_COUNT=6             # contact/booking forms per IP per window
# SITE_RATE_LIMIT_WINDOW_SECONDS=600
# SITE_UPLOAD_RATE_LIMIT_COUNT=60
# SITE_UPLOAD_RATE_LIMIT_WINDOW_SECONDS=600
# SITE_CORS_ORIGINS=http://localhost:4321   # dev only; production is same-origin
# SITE_MEDIA_BASE_URL=/api/media-files
# SITE_TRUST_PROXY=false

# =============================================================================
# Build-time settings for the site and the dashboard (docker compose build args)
# =============================================================================
# Swetrix analytics project id (swetrix.com > project settings). Baked into the site at
# `docker compose build site-static`; unset/blank = no analytics script at all.
# PUBLIC_SWETRIX_PID=
# Only for a self-hosted Swetrix API:
# PUBLIC_SWETRIX_API=
# The dashboard's VITE_LIVE / VITE_API_BASE are set in docker-compose.yml (live, same
# origin) and need no .env entry. CAFEOPS_API_URL / SITE_API_URL are only for the Astro
# dev server's proxy (site/web/astro.config.mjs), never for production.

# =============================================================================
# Deployment / operations -- read by deploy/*.sh and docker-compose.yml, NOT by
# cafeops itself (cafeops/config.py has no field for any of these)
# =============================================================================
# Read by deploy/backup.sh and deploy/restore.sh. CAFEOPS_DB_PATH is a plain
# filesystem path (NOT a sqlite+pysqlite:// URL) -- it must point at the same file
# CAFEOPS_DATABASE_URL above resolves to. Docker sets it (and the backup dir) itself;
# the systemd path needs it. See docs/OPERATIONS.md "backups".
# CAFEOPS_DB_PATH=/var/lib/cafeops/cafeops.db
# CAFEOPS_BACKUP_DIR=./backups
CAFEOPS_BACKUP_RETAIN_DAYS=14
# [Recommended for a real deployment] rsync destination, e.g.
# user@backup-host:/srv/cafeops-backups -- needs an SSH key already deployed
# out-of-band (never put a key in this file or an image). Unset means backups are
# LOCAL ONLY and deploy/backup.sh says so, loudly, every single night.
# CAFEOPS_BACKUP_REMOTE=
# Docker only: path to an SSH private key to bind-mount read-only into the `backup`
# service so it can reach CAFEOPS_BACKUP_REMOTE. See docker-compose.yml's commented-out
# volume line under the `backup` service.
# CAFEOPS_BACKUP_SSH_KEY=
# Docker only: UTC time-of-day the `backup` service's loop fires. Ignored by the
# systemd path, which uses deploy/systemd/cafeops-backup.timer's OnCalendar= instead.
CAFEOPS_BACKUP_TIME=02:00
# Local dev ports for ./start.sh (not docker): API_PORT=8000 WEB_PORT=5178
# SITE_API_PORT=8100 SITE_WEB_PORT=4321 -- set in the shell, not here.
