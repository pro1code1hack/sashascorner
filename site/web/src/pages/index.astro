---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import OpenNow from '../components/OpenNow.astro';
import Icon from '../components/Icon.astro';
import Slot from '../components/Slot.astro';
import RwCta from '../components/RwCta.astro';
import { slotCount } from '../components/slotData';
import { info, menu } from '../lib/data';
import type { MenuItem } from '../lib/types';
import { gbp, WEEKDAYS } from '../lib/format';

// Every number and price on this page is read from the menu export, so it moves
// when the board does. An item that has left the board drops out of the page
// rather than showing a stale price.
const all = menu.categories.flatMap((c) => c.items.map((i) => ({ ...i, cat: c.slug })));
const food = new Set(['breakfast', 'lunch', 'waffles', 'cakes']);
const drinks = all.filter((i) => !food.has(i.cat));
const matchas = drinks.filter((i) => /matcha|hojicha/i.test(i.name));
const cakes = all.filter((i) => i.cat === 'cakes');
const bakes = all.filter((i) => i.cat === 'cakes' || i.cat === 'waffles');
const cheapest = Math.min(...all.flatMap((i) => i.sizes.map((s) => s.price_pence)));
const byId = new Map(all.map((i) => [i.id, i]));
const from = (i: MenuItem) => Math.min(...i.sizes.map((s) => s.price_pence));
const price = (i: MenuItem) => `${i.sizes.length > 1 ? 'from ' : ''}${gbp(from(i))}`;

const stats = [
  { n: String(drinks.length), label: 'drinks on the board', short: 'drinks on the board', tone: 'warm' },
  { n: String(matchas.length), label: 'matcha & hojicha, green and blue', short: 'matcha & hojicha', tone: 'sage' },
  { n: String(bakes.length), label: 'cakes, bakes & waffles', short: 'cakes, bakes & waffles', tone: 'warm' },
  { n: gbp(cheapest), label: 'is where the board starts', short: 'where the board starts', tone: 'sage' },
];

const blue = byId.get('iced-honey-blue-matcha');
const raff = byId.get('raff-coffee');
const kyiv = byId.get('kyiv-cake-slice');

// The drinks board: a taste, coloured by family.
const family = (i: (typeof all)[number]) =>
  /blue/i.test(i.name)
    ? 'blue'
    : /hojicha/i.test(i.name)
      ? 'hojicha'
      : /matcha/i.test(i.name)
        ? 'matcha'
        : ['bubble-tea', 'milkshakes', 'cold'].includes(i.cat)
          ? 'other'
          : 'coffee';
const families = [
  { key: 'coffee', label: 'Coffee' },
  { key: 'matcha', label: 'Matcha' },
  { key: 'blue', label: 'Blue matcha' },
  { key: 'hojicha', label: 'Hojicha' },
  { key: 'other', label: 'Shakes & bubble tea' },
];
const tasteIds = [
  'raff-coffee', 'iced-honey-blue-matcha', 'cortado', 'iced-banana-bread-hojicha', 'lavender-matcha',
  'honey-vanilla-latte', 'honey-bubble-tea', 'iced-citrus-blue-matcha', 'iced-coconut-water-latte',
  'iced-mango-matcha', 'lavender-latte', 'strawberry-milkshake', 'iced-coconut-matcha', 'flat-white',
  'tropical-mint-bliss', 'single-espresso',
];
const taste = tasteIds.map((id) => byId.get(id)).filter((i) => i !== undefined);
// Phones show the first twelve.
const MOBILE_TASTE = 12;

// Build your drink: read off the board, never made up. Every drink name is split
// into base (the first chip row), flavour and temperature, so a new drink on the
// board shows up here by itself -- and a base with no drinks (ube, today) shows no chip.
type Base = { id: string; label: string; swatch: string; liquid: string; is: (n: string) => boolean; strip: RegExp };
const BASES: Base[] = [
  { id: 'ube', label: 'Ube', swatch: '#8a5fa8', liquid: '#8e68ad', is: (n) => /\bube\b/.test(n), strip: /\b(pure|ube|latte)\b/g },
  { id: 'green', label: 'Green matcha', swatch: '#7d9160', liquid: '#8aa35e', is: (n) => /matcha/.test(n) && !/blue/.test(n), strip: /\b(matcha|latte)\b/g },
  { id: 'blue', label: 'Blue matcha', swatch: '#3d6a9e', liquid: '#3d6a9e', is: (n) => /blue/.test(n) && /matcha/.test(n), strip: /\b(blue|matcha)\b/g },
  { id: 'coffee', label: 'Coffee', swatch: '#7a4f2e', liquid: '#a8744a', is: (n) => /\blatte\b/.test(n) && !/matcha|chai|hojicha|ube/.test(n), strip: /\blatte\b/g },
  { id: 'bubble', label: 'Bubble tea', swatch: '#d9c4a0', liquid: '#dcc7a1', is: (n) => /bubble tea/.test(n), strip: /\bbubble tea\b/g },
];
// Syrup band colour by the first flavour word it contains; unknown flavours stay clear.
const SYRUPS: Array<[RegExp, string]> = [
  [/brown sugar/, '#8a5a2b'], [/honey/, '#e3b04b'], [/lavender/, '#a792c9'], [/vanilla/, '#eadbb4'],
  [/mango/, '#f0a23a'], [/coconut/, '#efe8d6'], [/citrus|lemon/, '#f2d25c'], [/strawberr/, '#e8707a'],
  [/raspberr/, '#d9546e'], [/rose/, '#e9a0b4'], [/banana/, '#f3d77a'], [/kiwi/, '#9cc45a'],
  [/apple/, '#b5d36a'], [/peach/, '#f4b183'], [/pistachio/, '#b9c98a'], [/caramel/, '#c98a4b'],
  [/chocolate/, '#efe4cf'], [/passion/, '#f2b134'],
];
const slug = (s: string) => s.replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const combos: Record<string, { name: string; price: string }> = {};
const flavourLabels: Record<string, string> = {};
const baseFlavours: Record<string, string[]> = {};
for (const it of drinks) {
  const n = it.name.toLowerCase();
  const base = BASES.find((b) => b.is(n));
  if (!base) continue;
  const temp = /^iced\b/.test(n) || base.id === 'bubble' ? 'iced' : 'hot';
  const words = n.replace(/^iced\s+/, '').replace(base.strip, '').replace(/\s+/g, ' ').trim();
  const flavour = words ? slug(words) : 'classic';
  const k = `${base.id}|${flavour}|${temp}`;
  if (combos[k]) continue;
  combos[k] = { name: it.name, price: price(it) };
  flavourLabels[flavour] = words ? words.charAt(0).toUpperCase() + words.slice(1) : 'Classic';
  const list = (baseFlavours[base.id] ??= []);
  if (!list.includes(flavour)) flavour === 'classic' ? list.unshift(flavour) : list.push(flavour);
}
const bases = BASES.filter((b) => baseFlavours[b.id]?.length);
const allFlavours = [...new Set(bases.flatMap((b) => baseFlavours[b.id]))];
const syrup = (f: string) => SYRUPS.find(([re]) => re.test(f.replace(/-/g, ' ')))?.[1] ?? 'transparent';
const builder = {
  combos,
  flavours: baseFlavours,
  syrups: Object.fromEntries(allFlavours.map((f) => [f, syrup(f)])),
  liquids: Object.fromEntries(bases.map((b) => [b.id, b.liquid])),
  start: combos['blue|honey|iced'] ? 'blue|honey|iced' : (Object.keys(combos)[0] ?? ''),
};
const [b0, f0, t0] = builder.start.split('|');
const tempsOf = (base: string) => ['iced', 'hot'].filter((t) => Object.keys(combos).some((k) => k.startsWith(`${base}|`) && k.endsWith(`|${t}`)));
const first = combos[builder.start];

const waffles = ['pistachio-waffles', 'maple-fruity-waffles', 'cheesy-waffles']
  .map((id) => byId.get(id))
  .filter((i) => i !== undefined);
const waffleNote: Record<string, string> = { 'cheesy-waffles': 'with salad' };
const soup = byId.get('soup-of-the-day');
const kyivWhole = byId.get('kyiv-cake-whole');

// Opening hours, runs of days with the same times folded into one row.
type Row = { days: number[]; text: string };
const rows: Row[] = [];
for (const h of info?.hours ?? []) {
  const text = h.closed ? 'Closed' : `${h.open.replace(/^0/, '')} – ${h.close.replace(/^0/, '')}`;
  const last = rows.at(-1);
  if (last && last.text === text && last.days.at(-1) === h.weekday - 1) last.days.push(h.weekday);
  else rows.push({ days: [h.weekday], text });
}
const dayRange = (d: number[]) => (d.length === 1 ? WEEKDAYS[d[0]] : `${WEEKDAYS[d[0]]} – ${WEEKDAYS[d.at(-1)!]}`);

const mapsUrl = info
  ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`Sasha's Corner, ${info.address.line1}, ${info.address.city} ${info.address.postcode}`)}`
  : '';
const handle = info?.socials.instagram.replace(/\/$/, '').split('/').pop();
const range = (n: number) => Array.from({ length: n }, (_, i) => i);
---

<Base
  tone="dark"
  title="Sasha's Corner · Coffee, matcha & bubble tea café, Dundee"
  description="Independent café at 23 Commercial Street, Dundee: over 100 drinks, matcha whisked to order, blue matcha, Raff coffee, bubble tea, brunch and Kyiv cake."
>
  <Hero />

  <!-- The range in numbers ------------------------------------------------- -->
  <section class="stats on-dark" aria-label="The range in numbers">
    <dl class="wrap stats__grid">
      {
        stats.map((s) => (
          <div class={`stats__cell stats__cell--${s.tone}`}>
            <dt class="sr-only">{s.label}</dt>
            <dd>
              <span class="stats__n num">{s.n}</span>
              <span class="stats__label" aria-hidden="true">
                <span class="stats__long">{s.label}</span>
                <span class="stats__short">{s.short}</span>
              </span>
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- Three reasons ----------------------------------------------------------- -->
  <section class="sec reasons" aria-labelledby="reasons-title">
    <div class="wrap">
      <header class="sec-head sec-head--split" data-reveal>
        <div>
          <p class="label">Only at the corner</p>
          <h2 id="reasons-title" class="sec-title">Three reasons <span class="soft">to cross town.</span></h2>
        </div>
        <a class="more" href="/menu">All signatures <span aria-hidden="true">→</span></a>
      </header>
      <div class="reasons__grid">
        {
          blue && (
            <article class="reason reason--blue" data-reveal>
              <Slot key="home.blue-matcha" class="reason__photo" sizes="(max-width: 760px) 100vw, 33vw" />
              <div class="reason__body">
                <span class="tag">Most photographed</span>
                <h3>Blue matcha</h3>
                <p class="reason__desc">
                  Butterfly-pea flower whisked sky-blue — with honey and milk, or with citrus and sparkling water.
                </p>
                <p class="reason__price num">{price(blue)}</p>
              </div>
            </article>
          )
        }
        {
          raff && (
            <article class="reason reason--coffee" data-reveal>
              <div class="reason__art">
                <svg viewBox="0 0 240 240" fill="none" stroke="#fff5ea" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M62 96h116l-10 96a14 14 0 0 1-14 12H86a14 14 0 0 1-14-12z" />
                  <path d="M178 112c26 0 30 44 0 46" />
                  <path d="M68 112c30 10 74 10 104 0" />
                  <path d="M96 76c-8-12 8-20 0-34M124 76c-8-12 8-20 0-34M152 76c-8-12 8-20 0-34" />
                  <path d="M40 218h160" />
                </svg>
              </div>
              <div class="reason__body">
                <span class="tag">Eastern European classic</span>
                <h3>{raff.name}</h3>
                <p class="reason__desc">{raff.description}</p>
                <p class="reason__price num">{price(raff)}</p>
              </div>
            </article>
          )
        }
        {
          kyiv && (
            <article class="reason reason--olive" data-reveal>
              <div class="reason__art">
                <svg viewBox="0 0 240 240" aria-hidden="true" stroke-linejoin="round">
                  <path d="M40 150l90-60 70 40-90 62z" fill="#e2b48e" stroke="#2b2a1c" stroke-width="3" />
                  <path d="M40 150v26l70 34v-26z" fill="#c9a27e" stroke="#2b2a1c" stroke-width="3" />
                  <path d="M110 184v26l90-56v-24z" fill="#9b6038" stroke="#2b2a1c" stroke-width="3" />
                  <path d="M40 162l70 34M110 196l90-56" stroke="#f3efe4" stroke-width="5" />
                  <path d="M40 150v-18l90-60 70 40v18" fill="none" stroke="#2b2a1c" stroke-width="3" />
                  <path d="M40 132l70 34 90-56M110 166v18" fill="none" stroke="#2b2a1c" stroke-width="3" />
                  <path d="M44 134l66 32 86-54-66-38z" fill="#6e4428" />
                  <circle cx="96" cy="120" r="6" fill="#f3efe4" />
                  <circle cx="128" cy="104" r="6" fill="#f3efe4" />
                  <circle cx="150" cy="124" r="6" fill="#f3efe4" />
                  <circle cx="118" cy="138" r="6" fill="#f3efe4" />
                </svg>
              </div>
              <div class="reason__body">
                <span class="tag">By the slice or whole</span>
                <h3>Kyiv cake</h3>
                <p class="reason__desc">{kyiv.description}</p>
                <p class="reason__price num">{gbp(from(kyiv))} <span class="reason__unit">a slice</span></p>
              </div>
            </article>
          )
        }
      </div>
    </div>
  </section>

  <!-- Build your drink ---------------------------------------------------------- -->
  {
    first && (
      <section class="sec builder" aria-labelledby="builder-title" data-builder={JSON.stringify(builder)}>
        <div class="wrap builder__grid">
          <div class="builder__controls">
            <p class="label builder__kicker">Made in front of you</p>
            <h2 id="builder-title" class="sec-title builder__title">
              Build your <span class="soft">drink.</span>
            </h2>
            <p class="builder__lede">
              Matcha green or blue, a latte or a bubble tea — hot or over ice, plain or with a twist. Pick yours and
              show it at the bar.
            </p>
            <fieldset>
              <legend class="label">Base</legend>
              <div class="chips">
                {bases.map((b) => (
                  <button type="button" class="chip" data-dim="base" data-val={b.id} aria-pressed={String(b.id === b0)}>
                    <span class="chip__dot" style={`background:${b.swatch}`} aria-hidden="true" />
                    {b.label}
                  </button>
                ))}
              </div>
            </fieldset>
            <fieldset>
              <legend class="label">Flavour</legend>
              <div class="chips">
                {allFlavours.map((f) => (
                  <button
                    type="button"
                    class="chip"
                    data-dim="flavour"
                    data-val={f}
                    aria-pressed={String(f === f0)}
                    hidden={!builder.flavours[b0]?.includes(f)}
                  >
                    {flavourLabels[f]}
                  </button>
                ))}
              </div>
            </fieldset>
            <fieldset data-temps>
              <legend class="label">Temperature</legend>
              <div class="chips">
                {[
                  { id: 'iced', label: 'Over ice' },
                  { id: 'hot', label: 'Hot' },
                ].map((t) => (
                  <button
                    type="button"
                    class="chip"
                    data-dim="temp"
                    data-val={t.id}
                    aria-pressed={String(t.id === t0)}
                    hidden={!tempsOf(b0).includes(t.id)}
                  >
                    {t.label}
                  </button>
                ))}
              </div>
            </fieldset>
            <p class="builder__note" data-note hidden />
          </div>
          <div class="builder__card" data-base={b0} data-temp={t0} data-flavour={f0}>
            <svg class="cup" viewBox="0 0 300 380" aria-hidden="true">
              <path class="cup__steam" d="M110 62c-10-14 10-22 0-38M150 62c-10-14 10-22 0-38M190 62c-10-14 10-22 0-38" fill="none" stroke="#9a9580" stroke-width="3" stroke-linecap="round" />
              <path class="cup__liquid" d="M65 110L235 110L220 330Q218 346 202 346L98 346Q82 346 80 330Z" fill={builder.liquids[b0]} />
              <path class="cup__milk" d="M65 110L235 110L231 168L69 168Z" fill="#f6f1e4" opacity="0.92" />
              <path class="cup__syrup" d="M78 296L222 296L220 330Q218 346 202 346L98 346Q82 346 80 330Z" fill={builder.syrups[f0]} />
              <g class="cup__pearls" fill="#3b2a1e">
                <circle cx="104" cy="326" r="9" /><circle cx="126" cy="332" r="9" /><circle cx="150" cy="328" r="9" />
                <circle cx="174" cy="333" r="9" /><circle cx="197" cy="326" r="9" /><circle cx="115" cy="310" r="9" />
                <circle cx="140" cy="312" r="9" /><circle cx="163" cy="309" r="9" /><circle cx="186" cy="311" r="9" />
              </g>
              <g class="cup__ice">
                <rect x="92" y="126" width="46" height="46" rx="9" fill="#fff" opacity="0.55" transform="rotate(-12 115 149)" />
                <rect x="150" y="140" width="46" height="46" rx="9" fill="#fff" opacity="0.5" transform="rotate(14 173 163)" />
                <rect x="118" y="196" width="42" height="42" rx="9" fill="#fff" opacity="0.4" transform="rotate(6 139 217)" />
              </g>
              <path class="cup__straw" d="M168 20L150 250" stroke="#0d0d0b" stroke-width="12" stroke-linecap="round" />
              <path d="M58 60L242 60L220 330Q218 346 202 346L98 346Q82 346 80 330Z" fill="none" stroke="#0d0d0b" stroke-width="3" stroke-linejoin="round" />
              <path d="M50 60h200" stroke="#0d0d0b" stroke-width="3" stroke-linecap="round" />
            </svg>
            <div class="builder__out" aria-live="polite">
              <p class="label">Your drink</p>
              <p class="builder__name" data-name>{first.name}</p>
              <p class="builder__price num" data-price>{first.price}</p>
            </div>
          </div>
        </div>
      </section>
    )
  }

  <!-- The drinks board ------------------------------------------------------- -->
  <section class="sec board on-dark" aria-labelledby="board-title">
    <div class="wrap">
      <header class="sec-head sec-head--split" data-reveal>
        <div>
          <p class="label">The drinks board</p>
          <h2 id="board-title" class="sec-title">
            {drinks.length} drinks. <span class="soft board__soft"><span class="board__long">Here's a</span><span class="board__short">A</span> taste.</span>
          </h2>
        </div>
        <ul class="board__legend" aria-label="Key">
          {
            families.map((f) => (
              <li>
                <span class={`dot dot--${f.key}`} aria-hidden="true" />
                {f.label}
              </li>
            ))
          }
        </ul>
      </header>
      <ul class="board__chips" data-reveal>
        {
          taste.map((i, n) => (
            <li class:list={['bchip', { 'bchip--wide': n >= MOBILE_TASTE }]}>
              <span class={`dot dot--${family(i)}`} aria-hidden="true" />
              {i.name}
            </li>
          ))
        }
        <li class="bchip bchip--more">
          <span class="bchip__wide">+ {drinks.length - taste.length} more on the board</span>
          <span class="bchip__narrow">+ {drinks.length - Math.min(MOBILE_TASTE, taste.length)} more</span>
        </li>
      </ul>
      <a class="btn btn--ghost btn--lg board__all" href="/menu">See the full menu <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </section>

  <!-- Food -------------------------------------------------------------------- -->
  <section class="sec food" aria-labelledby="food-title">
    <div class="wrap">
      <header class="sec-head" data-reveal>
        <p class="label">Hungry too?</p>
        <h2 id="food-title" class="sec-title">Not just <span class="soft">a coffee stop.</span></h2>
      </header>
      <div class="food__grid">
        <article class="tile tile--waffles" data-reveal>
          <div class="tile__top">
            <div>
              <p class="label tile__eyebrow">Sweet or savoury</p>
              <h3>Waffles, <span class="tile__soft">for brunch.</span></h3>
            </div>
            <svg class="tile__icon" viewBox="0 0 120 120" aria-hidden="true" fill="none" stroke="#0d0d0b" stroke-width="2.4">
              <rect x="10" y="10" width="100" height="100" rx="22" fill="#e9b07a" />
              <path d="M35 10v100M60 10v100M85 10v100M10 35h100M10 60h100M10 85h100" />
            </svg>
          </div>
          <ul class="tile__list">
            {
              waffles.map((w) => {
                const note = w.description?.replace(/\.$/, '') ?? waffleNote[w.id];
                return (
                  <li>
                    <span>
                      <strong>{w.name}</strong>
                      {note && <span class="tile__note"> — {note}</span>}
                    </span>
                    <span class="num">{gbp(from(w))}</span>
                  </li>
                );
              })
            }
          </ul>
        </article>
        <article class="tile tile--bakes" data-reveal>
          <Slot key="home.bakes" class="tile__photo" sizes="(max-width: 760px) 100vw, 42vw" />
          <div class="tile__caption">
            <h3 class="tile__cap-title">Cakes &amp; bakes</h3>
            <span>{cakes.length} on the board</span>
          </div>
        </article>
        {
          soup && (
            <article class="tile tile--soup" data-reveal>
              <svg viewBox="0 0 48 48" width="44" height="44" fill="none" stroke="#0d0d0b" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M6 22h36a18 18 0 0 1-36 0z" />
                <path d="M18 14c-3-4 3-6 0-10M28 14c-3-4 3-6 0-10" />
              </svg>
              <div>
                <h3>Soup</h3>
                <p>Changes daily</p>
                <p class="num">{gbp(from(soup))}</p>
              </div>
            </article>
          )
        }
        <a class="tile tile--order on-dark" href="/order" data-reveal>
          <span class="label">To order{kyivWhole && <span class="tile__wide"> · {gbp(from(kyivWhole))}</span>}</span>
          <span class="tile__order">
            Whole Kyiv cake <span class="tile__wide">for your table</span>
            <span aria-hidden="true"> →</span>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- The corner ----------------------------------------------------------- -->
  <section class="sec corner" aria-labelledby="corner-title">
    <div class="wrap corner__grid">
      <div class="corner__copy" data-reveal>
        <p class="label">The corner</p>
        <h2 id="corner-title" class="sec-title">Stay for <span class="soft">a second one.</span></h2>
        <p class="corner__text">
          Sage walls, a sunny window bar, tables for catching up and a chess board if you fancy a game.
        </p>
        <a class="more" href="/about">Our story <span aria-hidden="true">→</span></a>
      </div>
      <ul class="corner__photos" aria-label="Photos from the café" data-reveal>
        {
          range(slotCount('home.corner', 3)).map((i) => (
            <li>
              <Slot key="home.corner" index={i} tone="paper" sizes="(max-width: 860px) 46vw, 18vw" />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Rewards -------------------------------------------------------------- -->
  <RwCta variant="section" src="site-home" />

  <!-- Visit ------------------------------------------------------------------ -->
  {
    info && (
      <section class="sec visit on-dark" aria-labelledby="visit-title">
        <div class="wrap visit__grid">
