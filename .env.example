# Copy to .env and fill in. Nothing here is required to run `cafeops seed --demo`.
CAFEOPS_DATABASE_URL=sqlite+pysqlite:///./cafeops.db
CAFEOPS_SQL_ECHO=false
CAFEOPS_LOCAL_TIMEZONE=Europe/London

# Lightspeed Restaurant K-Series. Leave blank to stay on fixtures.
CAFEOPS_LIGHTSPEED_CLIENT_ID=
CAFEOPS_LIGHTSPEED_CLIENT_SECRET=
CAFEOPS_LIGHTSPEED_REFRESH_TOKEN=
CAFEOPS_LIGHTSPEED_BUSINESS_ID=

CAFEOPS_TELEGRAM_BOT_TOKEN=
CAFEOPS_TELEGRAM_OWNER_CHAT_ID=

CAFEOPS_FINANCE_WORKBOOK_PATH=
