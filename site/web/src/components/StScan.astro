---
// Live camera scanning, the manual-entry fallback (also where a USB/Bluetooth
// barcode reader "types" its result), rejected-code messages and the undo strip
// for the last action, which stays live for its 2 minutes after moving on.
---

<section class="st-view st-scanview" data-view="scan" aria-labelledby="st-scan-h" hidden>
  <h2 id="st-scan-h" class="sr-only" tabindex="-1">Scan a card</h2>

  <div class="st-banner" data-convert-banner hidden>
    <p>
      <strong>Paper card, <span data-convert-n></span>.</strong>
      Scan the customer's new card to move the stamps across.
    </p>
    <button type="button" class="st-link" data-convert-cancel>Cancel</button>
  </div>

  <div class="st-camera" data-camera>
    <video data-video muted playsinline aria-hidden="true"></video>
    <div class="st-frame" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
    <p class="st-camera-hint" data-camera-hint>Hold the card's QR code inside the frame</p>
    <div class="st-camera-msg" data-camera-msg hidden>
      <p data-camera-text></p>
      <button type="button" class="btn btn--caramel" data-camera-start>Start camera</button>
    </div>
    <div class="st-checking" data-checking hidden role="status">Checking card…</div>
    <button type="button" class="st-torch" data-torch aria-pressed="false" hidden>
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 3h8l-1.5 5v12a1 1 0 0 1-1 1h-3a1 1 0 0 1-1-1V8z" /><path d="M8.6 5h6.8M12 12v3" /></svg>
      <span data-torch-label>Torch</span>
    </button>
  </div>

  <div class="st-reject" data-reject role="alert" hidden>
    <p class="st-reject-title" data-reject-title>Card rejected</p>
    <p data-reject-text></p>
  </div>

  <form class="st-manual" data-manual novalidate>
    <label class="field">
      <span>No camera, or it won't read? Type or paste the card code</span>
      <span class="st-manual-row">
        <input
          class="input"
          name="payload"
          autocomplete="off"
          autocapitalize="off"
          autocorrect="off"
          spellcheck="false"
          enterkeyhint="go"
          placeholder="SC1:…"
        />
        <button type="submit" class="btn btn--ghost">Look up</button>
      </span>
    </label>
  </form>

  <div class="st-undostrip" data-undo-strip hidden>
    <p data-undo-strip-text></p>
    <button type="button" class="btn btn--ghost" data-undo-strip-btn>Undo <span class="num" data-undo-clock></span></button>
  </div>
</section>
