# Copy to .env and fill in. `.env` is git-ignored -- keep it that way. Nothing here
# belongs in an image, a compose file, or a commit (see docs/OPERATIONS.md "secrets").
#
# Every CAFEOPS_* setting maps 1:1 onto a field in cafeops/config.py:Settings (prefix
# CAFEOPS_, case-insensitive). This file is grouped to match that file's section
# comments. Nothing here is required to run `uv run cafeops seed --demo` against
# fixtures -- the [REQUIRED ...] markers below are about what breaks in a REAL
# deployment, not about what the app will refuse to start without.

# =============================================================================
# Database
# =============================================================================
# Swapping SQLite for Postgres later is this line plus an Alembic branch
# (ARCHITECTURE.md 6.5). Docker/systemd deployments override this to point at the
# mounted data volume -- see docker-compose.yml and deploy/systemd/*.service.
CAFEOPS_DATABASE_URL=sqlite+pysqlite:///./cafeops.db
CAFEOPS_SQL_ECHO=false

# =============================================================================
# Locale
# =============================================================================
# Stored timestamps are always UTC (invariant enforced by db/types.UTCDateTime). This
# is only for presentation and for deciding which calendar day a sale belongs to
# (ARCHITECTURE.md 6.4 -- bucketing by local day, not UTC, is load-bearing for the
# weekday forecast).
CAFEOPS_LOCAL_TIMEZONE=Europe/London

# =============================================================================
# Read-only API -- single shared password (spec 1, no user management)
# =============================================================================
# [REQUIRED for a real deployment] Unset means the API FAILS CLOSED: every route
# except /api/health answers 503 rather than serving costs and margins to anyone who
# finds the port. That is deliberate (see cafeops/api/security.py and
# docs/OPERATIONS.md "blank screen"), not a bug to work around -- set this before
# anyone but you needs to use it.
CAFEOPS_API_PASSWORD=

# =============================================================================
# Telegram bot -- the owner's daily interface (Russian)
# =============================================================================
# [REQUIRED to start `cafeops bot-run` / the `bot` service] Both must be set together.
# `bot-run` exits 1 with a clear message rather than polling with no token -- see
# cafeops/bot/app.py:BotNotConfigured. Get the token from @BotFather; get the owner
# chat id by messaging the bot once and reading it off `getUpdates`, or from
# @userinfobot.
CAFEOPS_TELEGRAM_BOT_TOKEN=
CAFEOPS_TELEGRAM_OWNER_CHAT_ID=

# =============================================================================
# Lightspeed Restaurant K-Series -- fixtures-first (ARCHITECTURE.md 0, spec 13.3)
# =============================================================================
# All four optional. Absent credentials is a SUPPORTED state: `cafeops sync` defaults
# to --fixtures and `cafeops info` prints "fixtures only". Nothing touches the live POS
# until all four of client id/secret/refresh token/business id are set.
CAFEOPS_LIGHTSPEED_BASE_URL=https://api.lsk.lightspeed.app/v3
CAFEOPS_LIGHTSPEED_CLIENT_ID=
CAFEOPS_LIGHTSPEED_CLIENT_SECRET=
CAFEOPS_LIGHTSPEED_REFRESH_TOKEN=
CAFEOPS_LIGHTSPEED_BUSINESS_ID=
CAFEOPS_LIGHTSPEED_RATE_LIMIT_PER_SECOND=5.0
CAFEOPS_LIGHTSPEED_MAX_RETRIES=5

# =============================================================================
# Seed / import
# =============================================================================
# [REQUIRED for `cafeops seed --workbook`/`import-legacy` unless you pass --workbook
# explicitly on the command line] Path to the legacy finance workbook (.xlsx). The
# real file is committed as sashas_corner_finance__LEGACY_.xlsx -- see README.md and
# ARCHITECTURE.md "The workbook" for why that one file and not the two look-alikes
# also present in the repo's history.
CAFEOPS_FINANCE_WORKBOOK_PATH=./sashas_corner_finance__LEGACY_.xlsx

# =============================================================================
# Forecasting knobs (spec 5.3, ARCHITECTURE.md 8C)
# =============================================================================
# Defaults are what Phase 0/1 validated against the seeded scenario. Change these and
# re-read ARCHITECTURE.md 8C first -- alpha in particular controls how strongly a
# single unusual day swings base_daily.
CAFEOPS_EWMA_ALPHA=0.3
CAFEOPS_EWMA_WINDOW_DAYS=28
CAFEOPS_DOW_WINDOW_WEEKS=8
CAFEOPS_DOW_FACTOR_MIN=0.5
CAFEOPS_DOW_FACTOR_MAX=2.0
CAFEOPS_MIN_HISTORY_DAYS=14

# =============================================================================
# Labour and true margin (spec 5.6, answered spec 15.7)
# =============================================================================
# GBP pence per hour, LOADED (wage + employer NI + pension + holiday accrual),
# confirmed with the owner at £14.50/hr. Optional and deliberately so: clear it (blank,
# not 0) and every labour figure, true_margin and margin_per_minute in the system
# becomes None rather than a flattering number computed from a guess -- see
# cafeops/config.py's own comment on this field.
CAFEOPS_LOADED_HOURLY_RATE_PENCE=1450

# =============================================================================
# Channels -- Deliveroo / Just Eat (spec 4.6)
# =============================================================================
# CSV_UPLOAD is the path that works today: the owner has portal logins and exports by
# hand. BROWSER_AGENT drives a browser and falls back to CSV when it breaks (assume it
# will). PARTNER_API is not constructible -- partner APIs are gated to certified POS
# integrators (ARCHITECTURE.md 0).
CAFEOPS_CHANNEL_SOURCE=CSV_UPLOAD
CAFEOPS_CHANNEL_CSV_DIR=
CAFEOPS_CHANNEL_BROWSER_DRIVER=

# =============================================================================
# The bounded agent (spec 9) -- narration and browser automation only, never writes
# =============================================================================
# Optional. Absent key is a SUPPORTED state: the narration tool falls back to a
# deterministic template-built sentence rather than refusing to report (invariant 10
# still holds either way -- the agent never writes to stock/orders/composition, key or
# no key).
CAFEOPS_ANTHROPIC_API_KEY=
CAFEOPS_AGENT_MODEL=claude-opus-5
CAFEOPS_AGENT_MAX_TOKENS=1200
CAFEOPS_AGENT_MAX_TOOL_CALLS=12

# =============================================================================
# Drift gate (spec 5.2) -- the auto-order trust thresholds
# =============================================================================
# Defaults ARE the spec's own numbers. Do not loosen these to make more ingredients
# auto-order-eligible without re-reading invariant 2: eligibility is earned through
# drift history, never set manually, and these three numbers are what "earned" means.
CAFEOPS_DRIFT_AUTO_ORDER_MAX_PCT=10.0
CAFEOPS_DRIFT_WARN_MAX_PCT=15.0
CAFEOPS_DRIFT_CONSECUTIVE_COUNTS_REQUIRED=2

# =============================================================================
# Deployment / operations -- read by deploy/*.sh and the Caddyfile, NOT by cafeops
# itself (cafeops/config.py has no field for any of these)
# =============================================================================
# Caddy's TLS domain. Unset serves plain :80 so a fresh checkout can be curled
# immediately; set this to the VM's real DNS name for automatic HTTPS (see Caddyfile).
CAFEOPS_DOMAIN=

# Read by deploy/backup.sh and deploy/restore.sh. CAFEOPS_DB_PATH is a plain
# filesystem path (NOT a sqlite+pysqlite:// URL) -- it must point at the same file
# CAFEOPS_DATABASE_URL above resolves to. See docs/OPERATIONS.md "backups".
CAFEOPS_DB_PATH=
CAFEOPS_BACKUP_DIR=
CAFEOPS_BACKUP_RETAIN_DAYS=14
# [Recommended for a real deployment] rsync destination, e.g.
# user@backup-host:/srv/cafeops-backups -- needs an SSH key already deployed
# out-of-band (never put a key in this file or an image). Unset means backups are
# LOCAL ONLY and deploy/backup.sh says so, loudly, every single night.
CAFEOPS_BACKUP_REMOTE=
# Docker only: path to an SSH private key to bind-mount read-only into the `backup`
# service so it can reach CAFEOPS_BACKUP_REMOTE. See docker-compose.yml's commented-out
# volume line under the `backup` service.
CAFEOPS_BACKUP_SSH_KEY=
# Docker only: UTC time-of-day the `backup` service's loop fires. Ignored by the
# systemd path, which uses deploy/systemd/cafeops-backup.timer's OnCalendar= instead.
CAFEOPS_BACKUP_TIME=02:00
