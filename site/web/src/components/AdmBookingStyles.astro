---
// Global styles for the booking pieces built in scripts/admin-core/bookings.ts
// (rows, timeline, panels). Global because the elements are created by script.
---

<style is:global>
  .adm-stack {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .adm-form {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .adm-grid2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .adm-kv {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 6px 14px;
    font-size: 14px;
  }
  .adm-kv dt {
    color: var(--ink-2);
  }
  .adm-kv dd {
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  /* Timeline: one quiet bar per slot. */
  .adm-tl {
    display: flex;
    flex-direction: column;
  }
  .adm-tl-row {
    display: grid;
    grid-template-columns: 58px 1fr 64px;
    align-items: center;
    gap: 10px;
    min-height: 26px;
    border-bottom: 1px solid var(--line-row);
    font-size: 13px;
  }
  .adm-tl-row:last-child {
    border-bottom: 0;
  }
  .adm-tl-time {
    color: var(--ink-2);
  }
  .adm-tl-fig {
    text-align: right;
    font-weight: 700;
  }
  .adm-tl-fig--full {
    color: var(--alert);
  }
  .adm-tl-row--empty .adm-tl-fig {
    font-weight: 400;
    color: var(--ink-3);
  }
  .adm-tl .adm-meter {
    height: 8px;
    border-color: var(--line);
  }
  .adm-tl-row--empty .adm-meter {
    border-style: dashed;
  }

  /* Booking rows */
  .adm-bklist {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--line);
  }
  .adm-bk {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr) auto;
    align-items: center;
    gap: 4px 12px;
    padding: 8px 0;
    border-bottom: 1px solid var(--line);
    cursor: pointer;
  }
  .adm-bk:hover {
    background: var(--canvas-2);
  }
  .adm-bk-when {
    display: flex;
    flex-direction: column;
  }
  .adm-bk-time {
    font-size: 16px;
    font-weight: 800;
    letter-spacing: -0.01em;
  }
  .adm-bk-date {
    font-size: 12px;
    color: var(--ink-2);
  }
  .adm-bk-open {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
    min-height: 44px;
    justify-content: center;
    padding: 2px 0;
    border: 0;
    background: none;
    text-align: left;
    border-radius: var(--r-control);
  }
  .adm-bk-name {
    font-size: 15px;
    font-weight: 700;
    color: var(--ink);
    overflow-wrap: anywhere;
  }
  .adm-bk-meta {
    font-size: 13px;
    color: var(--ink-2);
  }
  .adm-bk-notes {
    font-size: 13px;
    color: var(--ink-2);
    font-style: normal;
    margin-top: 2px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .adm-bk-notes::before {
    content: '“';
  }
  .adm-bk-notes::after {
    content: '”';
  }
  .adm-bk-actions {
    display: flex;
    align-items: center;
    gap: 6px;
    justify-content: flex-end;
  }
  .adm-bk-act {
    min-height: 44px;
  }
  .adm-bk--cancelled .adm-bk-name,
  .adm-bk--cancelled .adm-bk-time {
    color: var(--ink-3);
    text-decoration: line-through;
  }
  .adm-bk--no_show .adm-bk-name {
    color: var(--ink-2);
  }
  @media (max-width: 520px) {
    .adm-bk {
      grid-template-columns: 68px minmax(0, 1fr);
      gap: 2px 8px;
    }
    .adm-bk-time {
      font-size: 15px;
    }
    .adm-bk-actions {
      grid-column: 2;
      justify-content: flex-start;
    }
  }

  .adm-bk-head {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .adm-bk-party {
    font-size: 16px;
    font-weight: 700;
  }
  .adm-bk-contact {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .adm-bk-danger {
    border-top: 1px solid var(--line-soft);
    padding-top: 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-items: flex-start;
  }
  .adm-drawer .adm-seg {
    align-self: flex-start;
    flex-wrap: wrap;
  }
</style>
