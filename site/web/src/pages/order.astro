---
// Order ahead for takeaway / collection: a Preact app (scripts/shop/) mounted client-only.
// Caddy and the Vite dev rewrite serve this page for every /order/* path (history
// routing), so the deep routes (/order/c/…, /order/p/…, /order/basket, …) stay
// client-rendered and only /order itself carries the crawlable copy below.
import Base from '../layouts/Base.astro';
import App from '../scripts/shop/App';
import '../styles/shop.css';

const site = Astro.site!;
const abs = (path: string) => new URL(path, site).href;
const title = "Order ahead for takeaway · Sasha's Corner, Dundee";
const description =
  "Order coffee, matcha, bubble tea, cakes and more to collect from Sasha's Corner, 23 Commercial Street, Dundee. Pay online or at the counter; we'll have it ready.";

// The page, and the café's own order-ahead entry point: an OrderAction on the café
// entity Base.astro already declares (`/#cafe`), for pick-up, not delivery.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${abs('/order')}#webpage`,
      url: abs('/order'),
      name: 'Order ahead for takeaway',
      description,
      inLanguage: 'en-GB',
      isPartOf: { '@id': abs('/#website') },
      about: { '@id': abs('/#cafe') },
      potentialAction: { '@type': 'OrderAction', target: abs('/order') },
    },
    {
      '@type': 'Restaurant',
      '@id': abs('/#cafe'),
      name: "Sasha's Corner",
      url: site.href,
      potentialAction: {
        '@type': 'OrderAction',
        name: 'Order ahead for collection',
        deliveryMethod: 'http://purl.org/goodrelations/v1#DeliveryModePickUp',
        target: {
          '@type': 'EntryPoint',
          urlTemplate: abs('/order'),
          inLanguage: 'en-GB',
          actionPlatform: ['https://schema.org/DesktopWebPlatform', 'https://schema.org/MobileWebPlatform'],
        },
      },
    },
  ],
};
---

<Base title={title} description={description} extraJsonLd={jsonLd}>
  <div class="sh-root" id="shop">
    <App client:only="preact" />
    <noscript>
      <div class="wrap sh-view">
        <h1 class="sh-h1">Order ahead for takeaway</h1>
        <p>
          Ordering online needs JavaScript. You can still see <a href="/menu">the menu</a>, or order at the counter at 23 Commercial
          Street.
        </p>
      </div>
    </noscript>
  </div>
</Base>
