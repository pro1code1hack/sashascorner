---
// Staff scanner (PWA) for Sasha's Corner Rewards: pair the device, sign in with a
// PIN, scan a card, add stamps, redeem rewards, convert paper cards, and help a
// customer back into their card. docs/loyalty/CONTRACT.md §5 is the API.
//
// Not a public page: noindex, not linked from anywhere, kept out of the sitemap
// (astro.config.mjs NOT_IN_SITEMAP). It uses the site's brand tokens but not
// Base.astro: no site header/footer, no JSON-LD; it is an app, full screen.
//
// Dev: /staff?mock=1 runs every screen against an in-page mock (scripts/staff/mock.ts
// lists the PINs and codes). /staff?mock=1&demo=<state> jumps to a state, for
// screenshots: pair pin scan reject card reward stamped manager drinks cap convert
// converting migrated void find recovery offline; phase 3: cards matcha points spent
// options cake join link.
import '../styles/global.css';
import sairaLatin from '@fontsource-variable/saira/files/saira-latin-wdth-normal.woff2?url';
import jostLatin from '@fontsource-variable/jost/files/jost-latin-wght-normal.woff2?url';
import StPair from '../components/StPair.astro';
import StPin from '../components/StPin.astro';
import StScan from '../components/StScan.astro';
import StConvert from '../components/StConvert.astro';
import StCard from '../components/StCard.astro';
import StFind from '../components/StFind.astro';
import StDialogs from '../components/StDialogs.astro';
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Staff scanner · Sasha's Corner</title>
    <meta name="description" content="Sasha's Corner Rewards: the staff scanner. For café staff on a paired device." />
    <meta name="theme-color" content="#474531" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="SC Staff" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="preload" href={sairaLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={jostLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/staff/manifest.webmanifest" />
  </head>
  <body class="st" data-view="boot" data-signed="0">
    <header class="st-bar on-dark">
      <div class="st-bar-in">
        <img class="st-logo" src="/brand/logo-reverse.svg" alt="Sasha's Corner" width="88" height="53" />
        <h1 class="st-title">Staff</h1>
        <div class="st-who" data-who hidden>
          <p class="st-who-name"><span data-who-name></span><span class="st-who-meta" data-who-meta></span></p>
          <button type="button" class="st-signout" data-signout>Sign out</button>
        </div>
      </div>
      <nav class="st-tabs" aria-label="Scanner" data-tabs hidden>
        <a href="#scan" class="st-tab" data-tab="scan">Stamp</a>
        <a href="#convert" class="st-tab" data-tab="convert">Paper card</a>
        <a href="#find" class="st-tab" data-tab="find">Find member</a>
      </nav>
    </header>

    <p class="st-offline" data-offline role="status" hidden>
      <strong>No connection.</strong> Stamps can't be added until it's back, and nothing is saved on this device to send later.
    </p>
    <p class="st-mockflag" data-mockflag hidden>Mock data (?mock=1): nothing here is real.</p>

    <main id="st-main" class="st-main">
      <div class="st-boot" data-view="boot" role="status">Starting…</div>
      <StPair />
      <StPin />
      <StScan />
      <StConvert />
      <StCard />
      <StFind />
    </main>

    <StDialogs />
    <div class="sr-only" data-live aria-live="polite" aria-atomic="true"></div>
    <div class="sr-only" data-live-assertive aria-live="assertive" aria-atomic="true"></div>

    <script>
      import { boot } from '../scripts/staff/main';
      boot();
    </script>
  </body>
</html>

<style is:global>
  /* Staff scanner. Brand tokens from global.css; everything here is under .st.
     Targets are 56px or more: a busy till, one hand, sometimes a wet thumb. */
  .st {
    --blush: #e9dcd6; /* the card's own colour (CONTRACT §9), used only on the card */
    --bar-h: 60px;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    background: var(--paper);
    -webkit-tap-highlight-color: transparent;
    overscroll-behavior-y: none;
  }
  .st [hidden] {
    display: none !important;
  }
  :where(.st) button {
    font: inherit;
    color: inherit;
    cursor: pointer;
    touch-action: manipulation;
  }
  :where(.st) ul,
  :where(.st) ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* ---- bar ------------------------------------------------------------------ */
  .st-bar {
    background: var(--olive-900);
    color: var(--on-dark);
    padding-top: env(safe-area-inset-top, 0px);
    position: sticky;
    top: 0;
    z-index: 20;
  }
  .st-bar-in {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: var(--bar-h);
    padding: 0 calc(16px + var(--safe-r)) 0 calc(16px + var(--safe-l));
    max-width: 1100px;
    margin: 0 auto;
  }
  .st-logo {
    width: 72px;
    height: auto;
    flex: none;
  }
  .st-title {
    font-size: var(--step-1);
    font-weight: 600;
    color: var(--sage-on-dark);
    padding-left: 12px;
    border-left: 1px solid color-mix(in oklab, var(--paper) 30%, transparent);
    line-height: 1.2;
  }
  .st-who {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
  }
  .st-who-name {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    line-height: 1.15;
    font-weight: 500;
    min-width: 0;
  }
  .st-who-name > span:first-child {
    max-width: 40vw;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .st-who-meta {
    font-size: 0.8rem;
    font-weight: 400;
    color: var(--on-dark-soft);
    white-space: nowrap;
  }
  .st-signout {
    min-height: 44px;
    padding: 0 12px;
    border: 1px solid color-mix(in oklab, var(--paper) 40%, transparent);
    border-radius: 999px;
    background: none;
    font-size: 0.95rem;
  }
  .st-signout:hover {
    background: color-mix(in oklab, var(--paper) 12%, transparent);
  }
  .st-tabs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 calc(8px + var(--safe-r)) 0 calc(8px + var(--safe-l));
  }
  .st-tab {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 0 6px;
    text-align: center;
    text-decoration: none;
    font-weight: 500;
    line-height: 1.1;
    color: var(--on-dark-soft);
    border-bottom: 3px solid transparent;
  }
  .st-tab[aria-current='page'] {
    color: var(--on-dark);
    border-bottom-color: var(--caramel);
  }

  .st-offline,
  .st-mockflag {
    margin: 0;
    padding: 12px 16px;
    text-align: center;
    font-size: var(--step--1);
  }
  .st-offline {
    background: var(--ink);
    color: var(--paper);
  }
  .st-mockflag {
    background: var(--oat);
    color: var(--coffee-deep);
    padding: 6px 16px;
  }

  /* ---- layout ------------------------------------------------------------- */
  .st-main {
    flex: 1;
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
    padding: 20px calc(16px + var(--safe-r)) calc(28px + var(--safe-b)) calc(16px + var(--safe-l));
  }
  .st-boot {
    padding: 48px 0;
    text-align: center;
    color: var(--olive-700);
  }
  .st:not([data-view='boot']) .st-boot {
    display: none;
  }
  .st-narrow {
    max-width: 460px;
    margin: 0 auto;
  }
  .st-view {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .st-h {
    font-size: var(--step-3);
    color: var(--olive-900);
  }
  /* Headings take focus only so a screen reader starts there after a view change; no
     ring. `:focus-visible` draws an outline AND a box-shadow halo, so both go --
     otherwise the halo is drawn round the whole heading box, over the reward sticker. */
  .st-h:focus,
  .st-pass-name:focus {
    outline: none;
    box-shadow: none;
  }
  .st-kicker {
    color: var(--coffee-deep);
    margin: 0;
  }
  .st-lede {
    color: var(--ink-soft);
  }
  .st-note {
    font-size: var(--step--1);
    color: var(--olive-700);
  }
  .st-err {
    padding: 12px 14px;
    border-left: 4px solid var(--coffee);
    background: color-mix(in oklab, var(--coffee) 10%, var(--paper));
    color: var(--ink);
    font-weight: 450;
    border-radius: 0 var(--radius-s) var(--radius-s) 0;
  }
  .st-form {
    display: grid;
    gap: 16px;
  }
  .st-wide {
    width: 100%;
    justify-content: center;
    min-height: 56px;
  }
  .st .btn:hover {
    transform: none;
  }
  .st-link {
    border: 0;
    background: none;
    padding: 0 4px;
    min-height: 44px;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    color: var(--coffee-deep);
    font-weight: 500;
  }
  .st-code {
    font-size: 2rem;
    letter-spacing: 0.3em;
    text-align: center;
    min-height: 64px;
  }

  /* ---- PIN ----------------------------------------------------------------- */
  .st-pinview {
    align-items: stretch;
    text-align: center;
    max-width: 380px;
  }
  .st-dots {
    display: flex;
    justify-content: center;
    gap: 14px;
    margin: 4px 0 2px;
  }
  .st-dots span {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 2px solid var(--olive-700);
    transition: background-color 0.12s;
  }
  .st-dots span.is-on {
    background: var(--olive-900);
    border-color: var(--olive-900);
  }
  .st-keypad {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }
  .st-key {
    min-height: 68px;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-m);
    background: var(--paper-bright);
    font-size: 1.9rem;
    font-weight: 600;
    color: var(--ink);
    display: grid;
    place-items: center;
    transition: background-color 0.1s;
  }
  .st-key:active {
    background: var(--oat);
  }
  .st-key--word {
    font-family: var(--font-text);
    font-size: 1rem;
    font-weight: 500;
    background: transparent;
    border-color: transparent;
    color: var(--olive-900);
  }
  .st-device {
    font-size: var(--step--1);
    color: var(--olive-700);
  }
  .is-shake {
    animation: st-shake 0.35s;
  }
  @keyframes st-shake {
    20%,
    60% {
      transform: translateX(-8px);
    }
    40%,
    80% {
      transform: translateX(8px);
    }
  }

  /* ---- scan -------------------------------------------------------------- */
  .st-scanview {
    max-width: 640px;
    margin: 0 auto;
  }
  .st-banner {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    border-radius: var(--radius-m);
    background: var(--oat);
    border: 1px solid var(--rule-strong);
  }
  .st-banner p {
    flex: 1;
  }
  .st-camera {
    position: relative;
    aspect-ratio: 1;
    max-height: 62vh;
    max-height: 62dvh;
    width: 100%;
    margin: 0 auto;
    border-radius: var(--radius-m);
    overflow: hidden;
    background: var(--olive-950);
    color: var(--paper);
  }
  .st-camera video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .st-frame {
    position: absolute;
    inset: 16%;
    pointer-events: none;
  }
  .st-frame i {
    position: absolute;
    width: 22%;
    height: 22%;
    border: 4px solid var(--paper);
  }
  .st-frame i:nth-child(1) {
    top: 0;
    left: 0;
    border-width: 4px 0 0 4px;
    border-top-left-radius: 14px;
  }
  .st-frame i:nth-child(2) {
    top: 0;
    right: 0;
    border-width: 4px 4px 0 0;
    border-top-right-radius: 14px;
  }
  .st-frame i:nth-child(3) {
    bottom: 0;
    left: 0;
    border-width: 0 0 4px 4px;
    border-bottom-left-radius: 14px;
  }
  .st-frame i:nth-child(4) {
    bottom: 0;
    right: 0;
    border-width: 0 4px 4px 0;
    border-bottom-right-radius: 14px;
  }
  .st-camera.is-reject .st-frame i {
    border-color: var(--caramel);
  }
  .st-camera-hint {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 28px 16px 12px;
    text-align: center;
    font-size: var(--step--1);
    background: linear-gradient(transparent, rgb(13 13 11 / 0.6));
  }
  .st-camera-msg {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    padding: 24px;
    text-align: center;
    background: var(--olive-900);
  }
  .st-camera-msg p {
    max-width: 34ch;
  }
  .st-checking {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: rgb(13 13 11 / 0.55);
    font-size: var(--step-1);
    font-weight: 500;
  }
  .st-torch {
    position: absolute;
    top: 12px;
    right: 12px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 48px;
    padding: 0 14px;
    border-radius: 999px;
    border: 1px solid color-mix(in oklab, var(--paper) 50%, transparent);
    background: rgb(13 13 11 / 0.45);
    color: var(--paper);
  }
  .st-torch[aria-pressed='true'] {
    background: var(--paper);
    color: var(--ink);
  }
  .st-reject {
    padding: 14px 16px;
    border-radius: var(--radius-m);
    background: var(--ink);
    color: var(--paper);
    border-left: 8px solid var(--caramel);
  }
  .st-reject-title {
    font-family: var(--font-display);
    font-stretch: 88%;
    font-weight: 600;
    font-size: var(--step-1);
    color: var(--caramel-on-dark);
  }
  .st-manual-row {
    display: flex;
    gap: 8px;
  }
  .st-manual-row .input {
    flex: 1;
    min-width: 0;
  }
  .st-manual-row .btn {
    flex: none;
    min-height: 50px;
  }
  .st-manual .field > span:first-child {
    color: var(--olive-700);
  }
  .st-undostrip {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 10px 10px 16px;
    border-radius: var(--radius-m);
    border: 1px solid var(--rule-strong);
    background: var(--paper-bright);
  }
  .st-undostrip p {
    flex: 1;
    min-width: 0;
  }
  .st-undostrip .btn {
    min-height: 48px;
    flex: none;
  }

  /* ---- convert ------------------------------------------------------------ */
  .st-stickers {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
  }
  .st-sticker {
    min-height: 68px;
    border-radius: var(--radius-m);
    border: 1px solid var(--rule-strong);
    background: var(--paper-bright);
    font-size: 1.9rem;
    font-weight: 600;
  }
  .st-sticker[aria-checked='true'] {
    background: var(--olive-900);
    border-color: var(--olive-900);
    color: var(--paper);
  }

  /* ---- card --------------------------------------------------------------- */
  .st-cardgrid {
    display: grid;
    gap: 18px;
    max-width: 560px;
    margin: 0 auto;
    width: 100%;
  }
  @media (min-width: 900px) {
    .st-cardgrid {
      max-width: none;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: start;
      gap: 28px;
    }
  }
  .st-pass {
    position: relative;
    grid-template-columns: minmax(0, 1fr);
    background: var(--blush);
    color: var(--olive-900);
    border-radius: 20px;
    padding: 20px 20px 22px;
    display: grid;
    gap: 6px;
  }
  .st-pass.is-void {
    background: var(--oat);
    color: var(--olive-700);
  }
  .st-pass-since {
    font-size: var(--step--1);
    color: var(--coffee-deep);
  }
  .st-pass-name {
    font-size: var(--step-4);
    overflow-wrap: anywhere;
  }
  .st-pass-count {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 4px 12px;
    color: var(--ink-soft);
  }
  .st-pass-big {
    font-size: var(--step-2);
    font-weight: 600;
    color: var(--olive-900);
  }
  .st-stamps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    margin-top: 10px;
  }
  .st-stamp {
    aspect-ratio: 1;
    border-radius: 50%;
    border: 2px dashed color-mix(in oklab, var(--olive-900) 40%, transparent);
    display: grid;
    place-items: center;
    color: color-mix(in oklab, var(--olive-900) 45%, transparent);
    font-family: var(--font-display);
    font-size: 1.1rem;
  }
  /* An earned slot is its sticker (scripts/rewards/stickers.ts): no ring, the
     die-cut is the edge, drawn a little larger than the cell. */
  .st-stamp.is-on {
    position: relative;
    border-color: transparent;
  }
  /* Absolutely placed so the oversize art never stretches the square cell. */
  .st-stampart {
    position: absolute;
    top: -11%;
    left: -11%;
    width: 122%;
    height: 122%;
    max-width: none;
    user-select: none;
    pointer-events: none;
  }
  .st-prize {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 76px;
    height: auto;
    pointer-events: none;
  }
  .st-prize[hidden] {
    display: none;
  }
  /* Room for the sticker as MARGIN, not padding: the element's box (and anything drawn
     on it) then stops short of the sticker instead of running underneath it. */
  .st-pass.has-prize .st-pass-prog,
  .st-pass.has-prize .st-pass-since,
  .st-pass.has-prize .st-pass-name,
  .st-pass.has-prize .st-pass-count {
    margin-right: 76px;
  }
  .st-pass-prog {
    font-family: var(--font-display);
    font-stretch: 88%;
    font-weight: 600;
    font-size: var(--step-0);
    color: var(--coffee-deep);
    letter-spacing: 0.02em;
  }
  .st-pass.is-points .st-stamp:not(.is-on) {
    border-style: solid;
    border-color: color-mix(in oklab, var(--olive-900) 22%, transparent);
  }

  /* ---- a member's cards (phase 3) --------------------------------------------- */
  .st-cardtabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    max-width: 560px;
    width: 100%;
    margin: 0 auto 2px;
  }
  @media (min-width: 900px) {
    .st-cardtabs {
      max-width: none;
    }
  }
  .st-cardtab {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 48px;
    padding: 6px 14px;
    border-radius: 999px;
    border: 1px solid var(--rule-strong);
    background: var(--paper-bright);
    color: var(--olive-900);
    font-weight: 500;
    white-space: nowrap;
  }
  .st-cardtab[aria-selected='true'] {
    background: var(--olive-900);
    border-color: var(--olive-900);
    color: var(--paper);
    --focus-ring: var(--caramel);
  }
  .st-cardtab-count {
    font-size: 0.9rem;
    opacity: 0.8;
  }
  .st-cardtab-dot {
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--caramel);
    color: var(--ink);
    font-size: 0.75rem;
    font-weight: 600;
  }

  /* ---- points: the spend ------------------------------------------------------- */
  .st-spendrow {
    display: flex;
    align-items: stretch;
    gap: 8px;
  }
  .st-pound {
    display: grid;
    place-items: center;
    min-width: 44px;
    font-size: 1.6rem;
    font-weight: 600;
    color: var(--olive-900);
  }
  .st-spend {
    flex: 1;
    min-width: 0;
    min-height: 64px;
    font-size: 1.8rem;
  }
  .st-spendgo {
    flex: none;
    min-height: 64px;
    padding-inline: 18px;
  }
  .st-cust {
    display: grid;
    min-width: 0;
    line-height: 1.25;
  }
  .st-cust strong {
    font-weight: 500;
  }
  .st-cust small {
    color: var(--olive-700);
    font-size: 0.85rem;
    overflow-wrap: anywhere;
  }
  .st-cust-when {
    flex: none;
    text-align: right;
    max-width: 45%;
  }
  .st-more {
    display: grid;
    gap: 8px;
  }
  .st-morebtns {
    display: grid;
    gap: 8px;
  }
  .st-stamp.is-new {
    animation: st-pop 0.45s var(--ease-out);
  }
  /* Single column (phones, portrait tablets): the whole card in one row, like the
