# Caddy terminates TLS in front of the API ONLY (spec 3). `bot` and `scheduler` have no
# host-published ports at all and are not reachable through this file or any other path.
#
# {$CAFEOPS_DOMAIN} is a Caddy environment placeholder (native syntax, no templating
# needed): set CAFEOPS_DOMAIN in .env to the VM's real DNS name and Caddy fetches a
# real Let's Encrypt certificate automatically on first request -- that IS "Caddy
# terminating TLS" per spec 3, with zero certificate machinery to operate by hand.
#
# Left unset, it falls back to :80 over plain HTTP so a fresh checkout can be curled
# immediately without owning a domain yet. Do not run the café on that in production --
# set CAFEOPS_DOMAIN.
{$CAFEOPS_DOMAIN:http://:80} {
	encode gzip

	# /api/* goes to the app. Everything else is the dashboard, served from the static
	# bundle baked into this image at build time (see Dockerfile, `web-builder` stage).
	# The API answers its own CORS preflight; Caddy just forwards.
	handle /api/* {
		reverse_proxy api:8000 {
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle {
		root * /srv/web
		# A single-page app owns its own routing, so an unknown path must return
		# index.html rather than a 404 -- otherwise a deep link, or a refresh on any
		# screen but the first, breaks.
		try_files {path} /index.html
		file_server
	}

	# Vite fingerprints every asset (index-D6jVRA65.js), so an asset URL can never
	# change contents and is safe to cache forever. index.html is the opposite: it is
	# the only file that names the current bundle, so caching it serves a stale app
	# after a deploy. This was not theoretical -- a cached index.html made a headless
	# audit report a layout bug that had already been fixed, against the old bundle.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	@html path / /index.html
	header @html Cache-Control "no-cache"

	header {
		# Belt-and-braces on top of the app's own security posture (single shared
		# password, no cookies -- see cafeops/api/security.py).
		-Server
		Strict-Transport-Security "max-age=31536000"
		# The bundle is entirely self-hosted and the API is same-origin, so there is
		# nothing legitimate to sniff, frame or leak a referrer to.
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		Cross-Origin-Opener-Policy "same-origin"
	}

	log {
		output stdout
		format console
	}
}
