---
// /admin/settings: café details, opening hours, booking rules, special closures and
// the admin password. Each section saves on its own.
import Admin from '../../layouts/Admin.astro';
import { WEEKDAYS } from '../../lib/format';

const RULES = [
  { key: 'covers_per_slot', label: 'Seats', unit: 'seats', hint: 'How many people the café can seat at once. Bookings stop when this is full.' },
  { key: 'max_party', label: 'Largest party online', unit: 'people', hint: 'Bigger groups are asked to use the contact form.' },
  { key: 'slot_minutes', label: 'Time between slots', unit: 'minutes', hint: 'e.g. 30 gives 9am, 9.30am, 10am…' },
  { key: 'duration_minutes', label: 'Table time', unit: 'minutes', hint: 'How long a booking holds its seats.' },
  { key: 'last_seating_before_close_minutes', label: 'Last booking before closing', unit: 'minutes', hint: '60 means the last table is an hour before you close.' },
  { key: 'min_lead_minutes', label: 'Notice needed', unit: 'minutes', hint: 'How soon ahead people can book online. Phone bookings ignore this.' },
  { key: 'horizon_days', label: 'How far ahead', unit: 'days', hint: 'How many days ahead the booking page shows.' },
];
---

<Admin title="Settings" active="settings" subtitle="what the website says about the café, and how bookings work">
  <p class="adm-err" data-error role="alert" hidden></p>
  <div class="set" data-settings aria-busy="true">
    <nav class="set-toc" aria-label="Settings sections">
      <a href="#set-details">Details</a>
      <a href="#set-hours">Hours</a>
      <a href="#set-rules">Bookings</a>
      <a href="#set-closures">Closures</a>
      <a href="#set-password">Password</a>
    </nav>

    <!-- Café details -->
    <section class="set-sec" id="set-details" aria-labelledby="set-details-h">
      <h2 class="adm-section-head" id="set-details-h">Café details</h2>
      <p class="adm-hint">Shown on the website and in search results.</p>
      <form class="set-form" data-form="details" novalidate>
        <div class="set-grid">
          <div class="adm-field set-wide"><label class="adm-label" for="c-name">Name</label><input class="adm-input" id="c-name" name="name" data-field="cafe.name" required /></div>
          <div class="adm-field"><label class="adm-label" for="c-phone">Phone</label><input class="adm-input" id="c-phone" name="phone" type="tel" data-field="cafe.phone" /></div>
          <div class="adm-field"><label class="adm-label" for="c-email">Email</label><input class="adm-input" id="c-email" name="email" type="email" data-field="cafe.email" aria-describedby="c-email-h" /><p class="adm-hint" id="c-email-h">Leave empty if there isn't one yet.</p></div>
          <div class="adm-field set-wide"><label class="adm-label" for="c-line1">Street address</label><input class="adm-input" id="c-line1" name="line1" data-field="cafe.address.line1" autocomplete="off" /></div>
          <div class="adm-field"><label class="adm-label" for="c-city">Town</label><input class="adm-input" id="c-city" name="city" data-field="cafe.address.city" /></div>
          <div class="adm-field"><label class="adm-label" for="c-postcode">Postcode</label><input class="adm-input" id="c-postcode" name="postcode" data-field="cafe.address.postcode" /></div>
          <div class="adm-field set-wide"><label class="adm-label" for="c-instagram">Instagram link</label><input class="adm-input" id="c-instagram" name="instagram" type="url" data-field="cafe.socials.instagram" placeholder="https://www.instagram.com/…" /></div>
          <div class="adm-field set-wide"><label class="adm-label" for="c-facebook">Facebook link</label><input class="adm-input" id="c-facebook" name="facebook" type="url" data-field="cafe.socials.facebook" placeholder="https://www.facebook.com/…" /></div>
          <div class="adm-field set-wide"><label class="adm-label" for="c-tiktok">TikTok link</label><input class="adm-input" id="c-tiktok" name="tiktok" type="url" data-field="cafe.socials.tiktok" placeholder="Leave empty if none" /></div>
        </div>
        <div class="set-save"><button class="adm-btn" type="submit">Save details</button><span class="set-status" role="status"></span></div>
      </form>
    </section>

    <!-- Hours -->
    <section class="set-sec" id="set-hours" aria-labelledby="set-hours-h">
      <h2 class="adm-section-head" id="set-hours-h">Opening hours</h2>
      <p class="adm-hint">Bookings follow these. For one-off days off, use Special closures below.</p>
      <form class="set-form" data-form="hours" novalidate>
        <table class="set-hours">
          <thead>
            <tr><th scope="col">Day</th><th scope="col">Open</th><th scope="col">Opens</th><th scope="col">Closes</th></tr>
          </thead>
          <tbody>
            {
              WEEKDAYS.map((d, i) => (
                <tr data-day={i}>
                  <th scope="row">{d}</th>
                  <td>
                    <label class="adm-check set-open">
                      <input type="checkbox" name={`open-${i}`} aria-label={`Open on ${d}`} />
                      <span aria-hidden="true">Open</span>
                    </label>
                  </td>
                  <td>
                    <input class="adm-input set-time" type="time" name={`from-${i}`} data-field={`cafe.hours.${i}.open`} aria-label={`${d} opens at`} step="900" />
                  </td>
                  <td>
                    <input class="adm-input set-time" type="time" name={`to-${i}`} data-field={`cafe.hours.${i}.close`} aria-label={`${d} closes at`} step="900" />
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
        <div class="set-save"><button class="adm-btn" type="submit">Save hours</button><span class="set-status" role="status"></span></div>
      </form>
    </section>

    <!-- Booking rules -->
    <section class="set-sec" id="set-rules" aria-labelledby="set-rules-h">
      <h2 class="adm-section-head" id="set-rules-h">Booking rules</h2>
      <p class="adm-hint">How the booking page on the website decides what's free.</p>
      <form class="set-form" data-form="rules" novalidate>
        <div class="set-grid">
          {
            RULES.map((r) => (
              <div class="adm-field">
                <label class="adm-label" for={`r-${r.key}`}>{r.label}</label>
                <div class="set-unit">
                  <input class="adm-input" id={`r-${r.key}`} name={r.key} data-field={`booking.${r.key}`} type="number" inputmode="numeric" min="0" step="1" aria-describedby={`r-${r.key}-h`} />
                  <span aria-hidden="true">{r.unit}</span>
                </div>
                <p class="adm-hint" id={`r-${r.key}-h`}>{r.hint}</p>
              </div>
            ))
          }
        </div>
        <div class="set-save"><button class="adm-btn" type="submit">Save booking rules</button><span class="set-status" role="status"></span></div>
      </form>
    </section>

    <!-- Closures -->
    <section class="set-sec" id="set-closures" aria-labelledby="set-closures-h">
      <h2 class="adm-section-head" id="set-closures-h">Special closures</h2>
      <p class="adm-hint">Days the café is shut outside the usual hours: holidays, private events. Nobody can book those days, and the booking page shows your note.</p>
      <ul class="set-closures" data-closures></ul>
      <form class="set-form set-addclosure" data-form="closure" novalidate>
        <div class="adm-field"><label class="adm-label" for="cl-date">Date</label><input class="adm-input" id="cl-date" name="date" type="date" data-field="closures" required /></div>
        <div class="adm-field set-grow"><label class="adm-label" for="cl-note">Note for guests</label><input class="adm-input" id="cl-note" name="note" maxlength="120" placeholder="e.g. Closed for Christmas" /></div>
        <button class="adm-btn adm-btn--secondary" type="submit">Add closure</button>
      </form>
    </section>

    <!-- Password -->
    <section class="set-sec" id="set-password" aria-labelledby="set-password-h">
      <h2 class="adm-section-head" id="set-password-h">Admin password</h2>
      <p class="adm-hint" data-pw-source></p>
      <form class="set-form set-pw" data-form="password" novalidate>
        <input type="text" name="username" autocomplete="username" value="owner" hidden />
        <div class="adm-field"><label class="adm-label" for="pw-cur">Current password</label><input class="adm-input" id="pw-cur" name="current" type="password" autocomplete="current-password" data-field="current" /></div>
        <div class="adm-field"><label class="adm-label" for="pw-new">New password</label><input class="adm-input" id="pw-new" name="new" type="password" autocomplete="new-password" minlength="10" data-field="new" aria-describedby="pw-new-h" /><p class="adm-hint" id="pw-new-h">At least 10 characters. A few words together is easiest to remember.</p></div>
        <div class="adm-field"><label class="adm-label" for="pw-new2">New password again</label><input class="adm-input" id="pw-new2" name="new2" type="password" autocomplete="new-password" data-field="new2" /></div>
        <p class="adm-hint">Changing it signs out every other phone and computer. This one stays signed in.</p>
        <div class="set-save"><button class="adm-btn" type="submit">Change password</button></div>
        <p class="set-pw-done" data-pw-done role="status" hidden></p>
      </form>
    </section>
  </div>
</Admin>

<style is:global>
  .set {
    display: flex;
    flex-direction: column;
    gap: 0;
    max-width: 760px;
  }
  .set[aria-busy='true'] {
    opacity: 0.6;
    pointer-events: none;
  }
  .set-toc {
    display: flex;
    gap: 4px;
    flex-wrap: wrap;
    margin-bottom: 6px;
  }
  .set-toc a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 12px;
    border-radius: 999px;
    border: 1px solid var(--line-control);
    text-decoration: none;
    font-size: 14px;
  }
  .adm .set-toc a {
    color: var(--ink);
  }
  .set-toc a:hover {
    background: var(--canvas);
  }
  .set-sec {
    padding: 22px 0 26px;
    border-bottom: 1px solid var(--line);
    scroll-margin-top: 12px;
  }
  .set-sec:last-child {
    border-bottom: 0;
  }
  .set-sec > .adm-hint {
    margin-top: 2px;
  }
  .set-form {
    margin-top: 14px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .set-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px 16px;
  }
  .set-wide {
    grid-column: 1 / -1;
  }
  .set-save {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .set-status {
    font-size: 14px;
    color: var(--ok-ink);
  }
  .set-status.is-bad {
    color: var(--bad-ink);
    font-weight: 600;
  }
  .set-unit {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .set-unit .adm-input {
    max-width: 120px;
    text-align: right;
  }
  .set-unit span {
    color: var(--ink-2);
  }
  .set-hours {
    border-collapse: collapse;
    width: 100%;
    max-width: 560px;
  }
  .set-hours th,
  .set-hours td {
    padding: 4px 8px 4px 0;
    text-align: left;
    border-bottom: 1px solid var(--line-row);
  }
  .set-hours thead th {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
    padding-bottom: 8px;
    border-bottom: 1px solid var(--line-soft);
  }
  .set-hours tbody th {
    font-weight: 600;
    font-size: 15px;
    white-space: nowrap;
  }
  .set-time {
    width: 124px;
  }
  .set-time:disabled {
    opacity: 0.4;
  }
  .set-open {
    min-height: 44px;
  }
  .set-closures {
    margin-top: 12px;
    border-top: 1px solid var(--line);
  }
  .set-closures li {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 6px 0;
    border-bottom: 1px solid var(--line);
    min-height: 52px;
  }
  .set-closures .d {
    font-weight: 700;
    width: 150px;
    flex: none;
  }
  .set-closures .n {
    flex: 1;
    min-width: 0;
    color: var(--ink-2);
    overflow-wrap: anywhere;
  }
  .set-closures .past .d {
    color: var(--ink-3);
  }
  .set-addclosure {
    flex-direction: row;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 12px;
  }
  .set-addclosure .adm-field:first-child {
    width: 180px;
  }
  .set-grow {
    flex: 1;
    min-width: 200px;
  }
  .set-pw {
    max-width: 380px;
  }
  .set-pw-done {
    background: var(--ok-wash);
    color: var(--ok-ink);
    border-radius: var(--r-button);
    padding: 10px 14px;
    font-size: 14px;
    font-weight: 600;
  }
  @media (max-width: 600px) {
    .set-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .set-hours thead th:nth-child(2) {
      font-size: 0;
    }
    .set-hours th,
    .set-hours td {
      padding-right: 6px;
    }
    .set-hours tbody th {
      font-size: 14px;
    }
    .set-open span {
      display: none;
    }
    .set-time {
      width: 100%;
      min-width: 0;
      padding: 0 6px;
    }
    .set-closures li {
      flex-wrap: wrap;
      gap: 4px 12px;
    }
    .set-closures .d {
      width: auto;
    }
    .set-addclosure .adm-field:first-child,
    .set-grow,
    .set-addclosure .adm-btn {
      width: 100%;
    }
  }
</style>

<script>
  import { ApiError, api, busy, clearFieldErrors, errorText, fill, h, ready, showFieldErrors, toast, changePassword, confirmTwice } from '../../scripts/admin-core';
  import { longDate, todayISO } from '../../scripts/admin-core/format';
  import type { Closure, Settings, Me } from '../../scripts/admin-core/types';

  const $ = <T extends HTMLElement>(sel: string, root: ParentNode = document) => root.querySelector<T>(sel)!;
  let s: Settings | null = null;
  const form = (k: string) => $<HTMLFormElement>(`[data-form="${k}"]`);
  const val = (f: HTMLFormElement, name: string) => (f.elements.namedItem(name) as HTMLInputElement).value.trim();
  const setVal = (f: HTMLFormElement, name: string, v: string | number | null | undefined) => ((f.elements.namedItem(name) as HTMLInputElement).value = v == null ? '' : String(v));

  function status(f: HTMLFormElement, text: string, bad = false) {
    const el = f.querySelector<HTMLElement>('.set-status');
    if (!el) return toast(text, { tone: bad ? 'bad' : 'info' });
    el.textContent = text;
    el.classList.toggle('is-bad', bad);
    if (!bad)
      window.setTimeout(() => {
        if (el.textContent === text) el.textContent = '';
      }, 5000);
  }

  function fillAll() {
    if (!s) return;
    const d = form('details');
    setVal(d, 'name', s.cafe.name);
    setVal(d, 'phone', s.cafe.phone);
    setVal(d, 'email', s.cafe.email);
    setVal(d, 'line1', s.cafe.address?.line1);
    setVal(d, 'city', s.cafe.address?.city);
    setVal(d, 'postcode', s.cafe.address?.postcode);
    for (const k of ['instagram', 'facebook', 'tiktok']) setVal(d, k, s.cafe.socials?.[k] ?? '');

    const hf = form('hours');
    for (let i = 0; i < 7; i++) {
      const hw = s.cafe.hours.find((x) => x.weekday === i);
      const open = !!hw && !hw.closed && !!hw.open;
      const cb = hf.elements.namedItem(`open-${i}`) as HTMLInputElement;
      cb.checked = open;
      setVal(hf, `from-${i}`, hw?.open ?? '');
      setVal(hf, `to-${i}`, hw?.close ?? '');
      paintDay(i);
    }

    const rf = form('rules');
    for (const [k, v] of Object.entries(s.booking)) {
      const el = rf.elements.namedItem(k) as HTMLInputElement | null;
      if (el) el.value = String(v);
    }
    renderClosures();
  }

  function paintDay(i: number) {
    const hf = form('hours');
    const cb = hf.elements.namedItem(`open-${i}`) as HTMLInputElement;
    for (const n of [`from-${i}`, `to-${i}`]) {
      const el = hf.elements.namedItem(n) as HTMLInputElement;
      el.disabled = !cb.checked;
    }
    const row = hf.querySelector<HTMLElement>(`[data-day="${i}"]`)!;
    row.querySelector('th')!.style.color = cb.checked ? '' : 'var(--ink-3)';
  }

  async function put(body: Partial<Settings>, f: HTMLFormElement, btn: HTMLButtonElement | null, okText: string) {
    clearFieldErrors(f);
    try {
      s = await busy(btn, 'Saving…', () => api.put<Settings>('/api/admin/settings', body));
      fillAll();
      status(f, okText);
      toast(okText);
      return true;
    } catch (e) {
      if (e instanceof ApiError && e.status === 422 && showFieldErrors(f, e.fields)) status(f, 'Check the highlighted field.', true);
      else status(f, errorText(e), true);
      return false;
    }
  }

  // ---- details ----
  form('details').addEventListener('submit', (e) => {
    e.preventDefault();
    if (!s) return;
    const f = form('details');
    if (!val(f, 'name')) {
      showFieldErrors(f, { 'cafe.name': 'The café needs a name.' });
      return;
    }
    const cafe = {
      ...s.cafe,
      name: val(f, 'name'),
      phone: val(f, 'phone'),
      email: val(f, 'email'),
      address: { ...s.cafe.address, line1: val(f, 'line1'), city: val(f, 'city'), postcode: val(f, 'postcode') },
      socials: { ...s.cafe.socials, instagram: val(f, 'instagram'), facebook: val(f, 'facebook'), tiktok: val(f, 'tiktok') },
    };
    void put({ cafe }, f, f.querySelector('button[type="submit"]'), 'Café details saved.');
  });

  // ---- hours ----
  for (let i = 0; i < 7; i++) (form('hours').elements.namedItem(`open-${i}`) as HTMLInputElement).addEventListener('change', () => paintDay(i));
  form('hours').addEventListener('submit', (e) => {
    e.preventDefault();
    if (!s) return;
    const f = form('hours');
    const errs: Record<string, string> = {};
    const hours = Array.from({ length: 7 }, (_, i) => {
      const open = (f.elements.namedItem(`open-${i}`) as HTMLInputElement).checked;
      const from = val(f, `from-${i}`);
      const to = val(f, `to-${i}`);
      if (!open) return { weekday: i, closed: true };
      if (!from) errs[`cafe.hours.${i}.open`] = 'Opening time?';
      else if (!to) errs[`cafe.hours.${i}.close`] = 'Closing time?';
      else if (to <= from) errs[`cafe.hours.${i}.close`] = 'Closes before it opens';
      return { weekday: i, open: from, close: to, closed: false };
    });
    if (Object.keys(errs).length) {
      showFieldErrors(f, errs);
      status(f, 'Check the highlighted times.', true);
      return;
    }
    void put({ cafe: { ...s.cafe, hours } }, f, f.querySelector('button[type="submit"]'), 'Opening hours saved.');
  });

  // ---- rules ----
  form('rules').addEventListener('submit', (e) => {
    e.preventDefault();
    if (!s) return;
    const f = form('rules');
    const booking = { ...s.booking };
    const errs: Record<string, string> = {};
    for (const k of Object.keys(s.booking) as (keyof Settings['booking'])[]) {
      const raw = val(f, k);
      const n = Number(raw);
      if (raw === '' || !Number.isInteger(n) || n < 0) errs[`booking.${k}`] = 'A whole number, 0 or more';
      else booking[k] = n;
    }
    if (!errs['booking.covers_per_slot'] && booking.covers_per_slot < 1) errs['booking.covers_per_slot'] = 'At least 1 seat';
    if (!errs['booking.max_party'] && booking.max_party > booking.covers_per_slot) errs['booking.max_party'] = `Can't be more than the ${booking.covers_per_slot} seats`;
    if (Object.keys(errs).length) {
      showFieldErrors(f, errs);
      status(f, 'Check the highlighted field.', true);
      return;
    }
    void put({ booking }, f, f.querySelector('button[type="submit"]'), 'Booking rules saved.');
  });

  // ---- closures ----
  function renderClosures() {
    if (!s) return;
    const today = todayISO();
    const list = [...s.closures].sort((a, b) => a.date.localeCompare(b.date));
    fill(
      $('[data-closures]'),
      list.length
        ? list.map((c) => {
            const rm = h('button', { type: 'button', class: 'adm-btn adm-btn--ghost', 'aria-label': `Remove the closure on ${longDate(c.date)}` }, 'Remove');
            confirmTwice(rm, 'Tap again to remove', () => void removeClosure(c, rm));
            return h(
              'li',
              { class: c.date < today ? 'past' : '' },
              h('span', { class: 'd' }, longDate(c.date)),
              h('span', { class: 'n' }, c.note || 'No note'),
              rm,
            );
          })
        : h('li', { class: 'adm-muted' }, 'No special closures.'),
    );
  }

  async function saveClosures(closures: Closure[], btn: HTMLButtonElement | null, okText: string) {
    return put({ closures }, form('closure'), btn, okText);
  }

  async function removeClosure(c: Closure, btn: HTMLButtonElement) {
    if (!s) return;
    await saveClosures(
      s.closures.filter((x) => x.date !== c.date),
      btn,
      `Closure on ${longDate(c.date)} removed.`,
    );
  }

  form('closure').addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!s) return;
    const f = form('closure');
    const date = val(f, 'date');
    const note = val(f, 'note');
    if (!date) {
      showFieldErrors(f, { closures: 'Pick a date.' });
      return;
    }
    if (s.closures.some((c) => c.date === date)) {
      showFieldErrors(f, { closures: 'That day is already on the list.' });
      return;
    }
    const ok = await saveClosures([...s.closures, { date, note }], f.querySelector('button[type="submit"]'), `Closed on ${longDate(date)}.`);
    if (ok) f.reset();
  });

  // ---- password ----
  form('password').addEventListener('submit', async (e) => {
    e.preventDefault();
    const f = form('password');
    const done = $('[data-pw-done]');
    done.hidden = true;
    clearFieldErrors(f);
    const cur = (f.elements.namedItem('current') as HTMLInputElement).value;
    const n1 = (f.elements.namedItem('new') as HTMLInputElement).value;
    const n2 = (f.elements.namedItem('new2') as HTMLInputElement).value;
    const errs: Record<string, string> = {};
    if (!cur) errs.current = 'Type the password you use now.';
    if (n1.length < 10) errs.new = `Needs at least 10 characters (this has ${n1.length}).`;
    else if (n1 === cur) errs.new = 'That is the same as the current one.';
    if (!errs.new && n1 !== n2) errs.new2 = "The two new passwords don't match.";
    if (Object.keys(errs).length) {
      showFieldErrors(f, errs);
      return;
    }
    try {
      await busy(f.querySelector('button[type="submit"]'), 'Changing…', () => changePassword(cur, n1));
      f.reset();
      done.textContent = `Password changed. Every other phone and computer has been signed out and will need the new password; this one stays signed in.${s?.telegram_configured ? ' A notice has gone to Telegram.' : ''}`;
      done.hidden = false;
      done.focus?.();
    } catch (err) {
      if (err instanceof ApiError && (err.status === 401 || err.status === 403 || err.status === 400)) showFieldErrors(f, { current: "That's not the current password." });
      else if (err instanceof ApiError && err.status === 422 && showFieldErrors(f, err.fields)) {
        /* shown */
      } else if (err instanceof ApiError && err.status === 429) showFieldErrors(f, { current: 'Too many tries. Wait a minute, then try again.' });
      else toast(errorText(err), { tone: 'bad' });
    }
  });

  ready().then(async (me: Me) => {
    $('[data-pw-source]').textContent =
      me.password_source === 'env'
        ? 'You are using the starting password from the server setup. Choose your own here.'
        : 'Change the password you sign in with.';
    try {
      s = await api.get<Settings>('/api/admin/settings');
      fillAll();
      $('[data-settings]').setAttribute('aria-busy', 'false');
    } catch (e) {
      const el = $('[data-error]');
      el.textContent = errorText(e);
      el.hidden = false;
    }
  });
</script>
