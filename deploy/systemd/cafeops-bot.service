[Unit]
Description=Cafe Ops Telegram bot (spec 3: separate systemd unit from the API)
After=network-online.target cafeops-api.service
Wants=network-online.target

[Service]
Type=simple
User=cafeops
Group=cafeops
WorkingDirectory=/opt/cafeops
EnvironmentFile=/etc/cafeops/cafeops.env
ExecStart=/opt/cafeops/.venv/bin/cafeops bot-run
Restart=on-failure
RestartSec=5
# `bot-run` exits 78 (sysexits EX_CONFIG) when CAFEOPS_TELEGRAM_BOT_TOKEN or
# CAFEOPS_TELEGRAM_OWNER_CHAT_ID are unset. That is a stable state, not a crash, so the
# unit stops on it rather than retrying every 5s forever -- a permanent restart loop is
# indistinguishable from a real crash and drowns genuine errors in the journal.
# `systemctl status cafeops-bot` shows "status=78" and the refusal message. Set the token
# in /etc/cafeops/cafeops.env, then `systemctl start cafeops-bot`. Any OTHER non-zero
# exit is a genuine fault and is still retried.
RestartPreventExitStatus=78

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/cafeops/data
UMask=0027

[Install]
WantedBy=multi-user.target
