---
// /admin/messages: the contact form's inbox. New / Handled / Archived.
import Admin from '../../layouts/Admin.astro';
---

<Admin title="Messages" active="messages" subtitle="from the contact form on the website">
  <div class="adm-chips msg-tabs" role="tablist" aria-label="Messages" data-tabs>
    <button type="button" role="tab" class="adm-chip" data-tab="new" id="tab-new" aria-controls="msg-panel">New <span class="adm-chip-count" data-count="new"></span></button>
    <button type="button" role="tab" class="adm-chip" data-tab="handled" id="tab-handled" aria-controls="msg-panel">Handled <span class="adm-chip-count" data-count="handled"></span></button>
    <button type="button" role="tab" class="adm-chip" data-tab="archived" id="tab-archived" aria-controls="msg-panel">Archived <span class="adm-chip-count" data-count="archived"></span></button>
  </div>
  <p class="adm-err" data-error role="alert" hidden></p>
  <div id="msg-panel" role="tabpanel" aria-labelledby="tab-new" data-panel aria-busy="true">
    <ul class="msg-list" data-list></ul>
  </div>
</Admin>

<style is:global>
  .msg-tabs {
    margin-bottom: 14px;
  }
  .msg-tabs .adm-chip[aria-selected='true'] {
    background: var(--brand-wash);
    border-color: var(--brand-line);
    color: var(--brand-ink);
    font-weight: 700;
  }
  [data-panel][aria-busy='true'] {
    opacity: 0.6;
  }
  .msg-list {
    border-top: 1px solid var(--line);
  }
  .msg {
    border-bottom: 1px solid var(--line);
  }
  .msg-head {
    width: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2px 12px;
    padding: 12px 4px;
    border: 0;
    background: none;
    text-align: left;
    min-height: 56px;
    border-radius: var(--r-control);
  }
  .msg-head:hover {
    background: var(--canvas-2);
  }
  .msg-who {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    min-width: 0;
  }
  .msg-name {
    font-size: 15px;
    font-weight: 700;
    overflow-wrap: anywhere;
  }
  .msg--new .msg-name::before {
    content: '';
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--brand);
    margin-right: 8px;
    vertical-align: 2px;
  }
  .msg-when {
    font-size: 13px;
    color: var(--ink-2);
    white-space: nowrap;
  }
  .msg-preview {
    grid-column: 1 / -1;
    color: var(--ink-2);
    font-size: 14px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .msg-head[aria-expanded='true'] .msg-preview {
    display: none;
  }
  .msg-body {
    padding: 0 4px 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .msg-text {
    font-size: 15px;
    line-height: 1.5;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    max-width: 68ch;
  }
  .msg-from {
    font-size: 13px;
    color: var(--ink-2);
    overflow-wrap: anywhere;
  }
  .msg-actions {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  @media (max-width: 520px) {
    .msg-actions .adm-btn {
      flex: 1 1 calc(50% - 4px);
    }
  }
</style>

<script>
  import { api, busy, errorText, fill, h, ready, setUnread, toast, announce } from '../../scripts/admin-core';
  import { ago, stamp } from '../../scripts/admin-core/format';
  import type { Message, MessageStatus } from '../../scripts/admin-core/types';

  const $ = <T extends HTMLElement>(sel: string) => document.querySelector<T>(sel)!;
  const TOPIC: Record<string, string> = {
    general: 'General',
    order: 'Cake order',
    events: 'Events',
    feedback: 'Feedback',
    press: 'Press',
    jobs: 'Jobs',
  };
  const topicLabel = (t: string) => TOPIC[t] ?? t.charAt(0).toUpperCase() + t.slice(1);

  const initial = new URLSearchParams(location.search).get('tab');
  let tab: MessageStatus = initial === 'handled' || initial === 'archived' ? initial : 'new';
  let all: Message[] = [];
  const open = new Set<number>();

  /** UK-looking phone numbers in free text: 07…, +44 7…, 01382 … */
  function phoneIn(text: string): string | null {
    const m = text.match(/(?:\+44\s?\(?0?\)?\s?|\b0)\d(?:[\s-]?\d){8,9}\b/);
    return m ? m[0].trim() : null;
  }
  const telHref = (p: string) => {
    const d = p.replace(/[^\d+]/g, '');
    return `tel:${d}`;
  };

  async function load() {
    const panel = $('[data-panel]');
    panel.setAttribute('aria-busy', 'true');
    try {
      all = await api.get<Message[]>('/api/admin/messages', { status: 'all' });
      $('[data-error]').hidden = true;
      render();
    } catch (e) {
      const el = $('[data-error]');
      el.textContent = errorText(e);
      el.hidden = false;
    } finally {
      panel.setAttribute('aria-busy', 'false');
    }
  }

  function render() {
    const counts: Record<MessageStatus, number> = { new: 0, handled: 0, archived: 0 };
    for (const m of all) counts[m.status]++;
    setUnread(counts.new);
    document.querySelectorAll<HTMLElement>('[data-count]').forEach((c) => {
      const k = c.dataset.count as MessageStatus;
      c.textContent = counts[k] ? String(counts[k]) : '';
    });
    document.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach((t) => {
      const on = t.dataset.tab === tab;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
    });
    $('[data-panel]').setAttribute('aria-labelledby', `tab-${tab}`);
    const list = all.filter((m) => m.status === tab).sort((a, b) => b.created_at.localeCompare(a.created_at));
    const empty = { new: 'No new messages. You are all caught up.', handled: 'Nothing handled yet.', archived: 'Nothing archived.' }[tab];
    fill($('[data-list]'), list.length ? list.map(item) : h('li', { class: 'adm-empty' }, empty));
  }

  function item(m: Message): HTMLElement {
    const bodyId = `msg-${m.id}`;
    const expanded = open.has(m.id);
    const head = h(
      'button',
      { type: 'button', class: 'msg-head', 'aria-expanded': String(expanded), 'aria-controls': bodyId },
      h('span', { class: 'msg-who' }, h('span', { class: 'msg-name' }, m.name), h('span', { class: 'adm-pill' }, topicLabel(m.topic))),
      h('span', { class: 'msg-when', title: stamp(m.created_at) }, ago(m.created_at)),
      h('span', { class: 'msg-preview' }, m.message),
    );
    if (m.status === 'new') head.setAttribute('aria-label', `New message from ${m.name}, ${topicLabel(m.topic)}, ${ago(m.created_at)}`);
    const phone = phoneIn(m.message);
    const subject = `Re: your message to Sasha's Corner${m.topic && m.topic !== 'general' ? ` (${topicLabel(m.topic).toLowerCase()})` : ''}`;
    const quoted = `\n\n---\nOn ${stamp(m.created_at)}, ${m.name} wrote:\n${m.message}`;
    const actions = h(
      'div',
      { class: 'msg-actions' },
      m.email ? h('a', { class: 'adm-btn', href: `mailto:${m.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(quoted)}` }, 'Reply by email') : null,
      phone ? h('a', { class: 'adm-btn adm-btn--secondary', href: telHref(phone) }, `Call ${phone}`) : null,
    );
    const move = (to: MessageStatus, label: string, doing: string, done: string) => {
      const b = h('button', { type: 'button', class: 'adm-btn adm-btn--secondary' }, label);
      b.addEventListener('click', async () => {
        const from = m.status;
        try {
          const nm = await busy(b, doing, () => api.patch<Message>(`/api/admin/messages/${m.id}`, { status: to }));
          replace(nm);
          open.delete(m.id);
          render();
          focusAfterRemoval();
          toast(done, {
            action: {
              label: 'Undo',
              run: () =>
                void api.patch<Message>(`/api/admin/messages/${m.id}`, { status: from }).then(
                  (back) => {
                    replace(back);
                    render();
                  },
                  (e) => toast(errorText(e), { tone: 'bad' }),
                ),
            },
          });
        } catch (e) {
          toast(errorText(e), { tone: 'bad' });
        }
      });
      return b;
    };
    if (m.status === 'new') actions.append(move('handled', 'Mark handled', 'Saving…', 'Marked handled.'), move('archived', 'Archive', 'Archiving…', 'Archived.'));
    else if (m.status === 'handled') actions.append(move('archived', 'Archive', 'Archiving…', 'Archived.'), move('new', 'Mark as new', 'Saving…', 'Back in New.'));
    else actions.append(move('new', 'Move back to New', 'Saving…', 'Back in New.'));

    const body = h(
      'div',
      { class: 'msg-body', id: bodyId, hidden: !expanded },
      h('p', { class: 'msg-text' }, m.message),
      h('p', { class: 'msg-from' }, `${m.name} · ${m.email || 'no email given'} · ${stamp(m.created_at)}${m.handled_at && m.status !== 'new' ? ` · dealt with ${ago(m.handled_at)}` : ''}`),
      actions,
    );
    head.addEventListener('click', () => {
      const now = head.getAttribute('aria-expanded') !== 'true';
      head.setAttribute('aria-expanded', String(now));
      body.hidden = !now;
      if (now) open.add(m.id);
      else open.delete(m.id);
    });
    return h('li', { class: `msg msg--${m.status}`, 'data-id': m.id }, head, body);
  }

  function replace(nm: Message) {
    const i = all.findIndex((x) => x.id === nm.id);
    if (i >= 0) all[i] = nm;
  }

  function focusAfterRemoval() {
    const next = document.querySelector<HTMLElement>('.msg-head') ?? document.querySelector<HTMLElement>(`[data-tab="${tab}"]`);
    next?.focus();
  }

  function setTab(t: MessageStatus, focus = false) {
    tab = t;
    const u = new URL(location.href);
    if (t === 'new') u.searchParams.delete('tab');
    else u.searchParams.set('tab', t);
    history.replaceState(null, '', u.pathname + u.search);
    render();
    if (focus) document.querySelector<HTMLElement>(`[data-tab="${t}"]`)?.focus();
    announce(`${t.charAt(0).toUpperCase() + t.slice(1)} messages`);
  }

  const order: MessageStatus[] = ['new', 'handled', 'archived'];
  document.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach((b) => b.addEventListener('click', () => setTab(b.dataset.tab as MessageStatus)));
  $('[data-tabs]').addEventListener('keydown', (e) => {
    const k = (e as KeyboardEvent).key;
    if (k !== 'ArrowLeft' && k !== 'ArrowRight') return;
    e.preventDefault();
    const i = order.indexOf(tab);
    setTab(order[(i + (k === 'ArrowRight' ? 1 : order.length - 1)) % order.length], true);
  });

  ready().then(load);
</script>
