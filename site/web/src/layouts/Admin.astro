---
// The website admin's shell. Dressed in the café's own brand (owner's call,
// 2026-09-28): the palette measured for the public site (styles/global.css), Saira
// for headings and figures, Jost for text, an olive sidebar with a caramel "you are
// here". Layout and behaviour still follow the back-office system
// (docs/design/specs/design-system.md). Sidebar on desktop, bottom tab bar under
// 760px. Everything under /admin is noindex.
//
// Props:
//   title    page title, shown in the header bar and the <title>
//   active   which nav item is current: dashboard | bookings | messages | events | menu | photos | settings
//   subtitle optional sentence under the title (what the page is for)
//   wide     let the content use the full width (tables, the week view)
//
// Slots: default (the page), `actions` (right of the title in the header bar).
//
// Auth: the shell checks the session before the page's own script runs anything
// (`ready()` in scripts/admin-core/session.ts). Signed out, every page except
// /admin sends the owner to /admin?next=<this page>; /admin shows the sign-in form.
import '@fontsource-variable/saira/wdth.css';
import '@fontsource-variable/jost/index.css';
import sairaLatin from '@fontsource-variable/saira/files/saira-latin-wdth-normal.woff2?url';
import jostLatin from '@fontsource-variable/jost/files/jost-latin-wght-normal.woff2?url';
import AdmSignIn from '../components/AdmSignIn.astro';

interface Props {
  title: string;
  active: 'dashboard' | 'bookings' | 'messages' | 'events' | 'menu' | 'photos' | 'settings';
  subtitle?: string;
  wide?: boolean;
}
const { title, active, subtitle, wide = false } = Astro.props;

const NAV = [
  { key: 'dashboard', href: '/admin', label: 'Today', icon: 'today' },
  { key: 'bookings', href: '/admin/bookings', label: 'Bookings', icon: 'bookings' },
  { key: 'messages', href: '/admin/messages', label: 'Messages', icon: 'messages' },
  { key: 'events', href: '/admin/events', label: 'Events', icon: 'events' },
  { key: 'menu', href: '/admin/menu', label: 'Menu', icon: 'menu' },
  { key: 'photos', href: '/admin/photos', label: 'Photos', icon: 'photos' },
  { key: 'settings', href: '/admin/settings', label: 'Settings', icon: 'settings' },
] as const;

// 24px line icons, stroke = currentColor.
const ICON: Record<string, string> = {
  today: '<rect x="4" y="5" width="16" height="15" rx="2.5"/><path d="M4 9.5h16M8.5 3v4M15.5 3v4"/><circle cx="12" cy="14.5" r="1.6" fill="currentColor" stroke="none"/>',
  bookings: '<path d="M5 20V9M19 20V9M3.5 9h17M8 9V6.5h8V9M5 14h14"/>',
  messages: '<path d="M4.5 6.5h15a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H10l-4 3v-3H4.5a1 1 0 0 1-1-1v-9a1 1 0 0 1 1-1Z"/>',
  menu: '<path d="M6 4.5h12v15H6zM9 9h6M9 12.5h6M9 16h4"/>',
  events: '<path d="M12 3.5l2.5 5.2 5.5.8-4 3.9 1 5.6-5-2.7-5 2.7 1-5.6-4-3.9 5.5-.8z"/>',
  photos: '<rect x="3.5" y="5.5" width="17" height="13" rx="2"/><circle cx="9" cy="10.5" r="1.8"/><path d="m4 17 5-4.5 3.5 3 3-2.5 4.5 4"/>',
  settings: '<circle cx="12" cy="12" r="3"/><path d="M12 3.5v2.2M12 18.3v2.2M20.5 12h-2.2M5.7 12H3.5M18 6l-1.6 1.6M7.6 16.4 6 18M18 18l-1.6-1.6M7.6 7.6 6 6"/>',
};
const isIndex = active === 'dashboard';
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · Admin · Sasha's Corner</title>
    <meta name="theme-color" content="#474531" />
    <link rel="preload" href={sairaLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={jostLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // Keep ?mock=1 across the admin's own links (development only).
      try {
        var q = new URLSearchParams(location.search);
        if (q.get('mock') === '1') sessionStorage.setItem('sc-adm-mock', '1');
        if (q.get('mock') === '0') sessionStorage.removeItem('sc-adm-mock');
      } catch (e) {}
    </script>
  </head>
  <body class="adm" data-auth="pending" data-page={active} data-index={isIndex ? '1' : undefined}>
    <a class="adm-skip" href="#adm-main" data-skip>Skip to content</a>

    <div class="adm-signin-wrap" data-when="out">
      {isIndex && <AdmSignIn />}
    </div>

    <div class="adm-app" data-when="in">
      <aside class="adm-side" aria-label="Admin">
        <a class="adm-brand" href="/admin" aria-label="Sasha's Corner admin, today">
          <img src="/brand/logo-reverse.svg" alt="" width="120" height="72" />
          <span class="adm-brand-sub">Website admin</span>
        </a>
        <p class="adm-grouphead" id="adm-nav-head">Website</p>
        <nav aria-labelledby="adm-nav-head">
          <ul class="adm-nav">
            {NAV.map((n) => (
              <li>
                <a
                  href={n.href}
                  class="adm-nav-item"
                  aria-current={n.key === active ? 'page' : undefined}
                  data-nav={n.key}
                >
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICON[n.icon]} />
                  <span class="adm-nav-label">{n.label}</span>
                  {n.key === 'messages' && <span class="adm-badge" data-unread hidden></span>}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <div class="adm-side-foot">
          <a class="adm-side-link" href="/" target="_blank" rel="noopener">View the website</a>
          <button type="button" class="adm-side-link" data-signout>Sign out</button>
          <p class="adm-mockflag" data-mockflag hidden>Mock data (?mock=1)</p>
        </div>
      </aside>

      <div class="adm-col">
        <header class="adm-head">
          <div class="adm-head-text">
            <h1 class="adm-title">{title}</h1>
            {subtitle && <p class="adm-sub">{subtitle}</p>}
          </div>
          <div class="adm-head-actions">
            <slot name="actions" />
            <button type="button" class="adm-head-signout" data-signout>Sign out</button>
          </div>
        </header>
        <main id="adm-main" class:list={['adm-main', { 'adm-main--wide': wide }]} tabindex="-1">
          <slot />
        </main>
      </div>

      <nav class="adm-tabs" aria-label="Admin sections">
        {NAV.map((n) => (
          <a href={n.href} class="adm-tab" aria-current={n.key === active ? 'page' : undefined} data-nav={n.key}>
            <span class="adm-tab-icon">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICON[n.icon]} />
              {n.key === 'messages' && <span class="adm-badge adm-badge--dot" data-unread hidden></span>}
            </span>
            <span class="adm-tab-label">{n.label}</span>
          </a>
        ))}
      </nav>
    </div>

    <div class="adm-loading" data-when="pending" role="status">Checking you're signed in…</div>

    <div class="adm-toasts" data-toasts aria-live="polite" aria-atomic="false"></div>
    <div class="adm-sr" data-live aria-live="polite" aria-atomic="true"></div>
    <div class="adm-sr" data-live-assertive aria-live="assertive" aria-atomic="true"></div>

    <script>
      import { bootShell } from '../scripts/admin-core/shell';
      bootShell();
    </script>
  </body>
</html>

<style is:global>
  /* ---- tokens -----------------------------------------------------------------
     Same names as the back-office system (design-system.md §4) so every page's
     rules keep working; the values are the café's brand (styles/global.css), each
     text pair checked to WCAG AA. */
  .adm {
    --surface: #faf9f5; /* cards, inputs, drawers: paper lifted toward white */
    --canvas: #f3f1eb; /* paper: the page */
    --canvas-2: #efece4;
    --wash: #ebe6dd; /* oat */
    --ink: #0d0d0b;
    --ink-2: #55533f; /* 6.9:1 on paper */
    --ink-3: #676551; /* 4.5:1 on oat, 5.3:1 on paper */
    --line: #e1ddd2;
    --line-soft: #e8e4da;
    --line-row: #ebe8e0;
    --line-control: #d3cdbe;
    --line-strong: #bdb6a4;
    --brand: #474531; /* olive-900: primary surfaces, selected states */
    --brand-ink: #474531; /* olive as text: links, active labels (8.6:1 on paper) */
    --brand-deep: #34331f;
    --brand-wash: #e4e9d8; /* sage tint */
    --brand-line: #c3cca9;
    --accent: #d4884e; /* caramel: the one call to action, "you are here" */
    --accent-hover: #dc9b69;
    --accent-ink: #7d4d2c; /* coffee, for small labels: 6.3:1 on paper */
    --accent-wash: #f6e6d6;
    --sage: #899c6a;
    --on-brand: #f3f1eb; /* paper on olive: 8.6:1 */
    --on-brand-2: #cfcbbb; /* quieter text on olive: 6.0:1 */
    --on-brand-accent: #e0ac81; /* caramel lifted for text on olive: 4.8:1 */
    --alert: #b4412c;
    --alert-wash: #f9ebe6;
    --bad-ink: #9e3624;
    --bad-wash: #f6e0d9;
    --warn-ink: #7d4d2c;
    --warn-wash: #f6e6d6;
    --ok: #899c6a;
    --ok-ink: #3f5226;
    --ok-wash: #e3ead4;
    --est-wash: #f6ecdc;
    --font-display: 'Saira Variable', 'Saira', system-ui, sans-serif;
    --font-text: 'Jost Variable', 'Jost', system-ui, sans-serif;
    --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
    --r-xs: 6px;
    --r-control: 10px;
    --r-button: 12px;
    --r-card: 14px;
    --r-card-lg: 16px;
    --r-login: 24px;
    --shadow-raised: 0 1px 2px rgb(52 51 31 / 0.08), 0 0 0 1px rgb(52 51 31 / 0.05);
    --shadow-seg: 0 1px 2px rgb(52 51 31 / 0.12);
    --shadow-login: 0 1px 2px rgb(52 51 31 / 0.05), 0 16px 40px rgb(52 51 31 / 0.1);
    --tabbar-h: 64px;
    --side-w: 232px;
    --scrim: rgb(52 51 31 / 0.32);

    color-scheme: light;
    margin: 0;
    background: var(--canvas);
    color: var(--ink);
    font-family: var(--font-text);
    font-size: 15px;
    line-height: 1.45;
    font-variant-numeric: tabular-nums;
    -webkit-font-smoothing: antialiased;
    -webkit-text-size-adjust: 100%;
    /* A guest's unbroken email or note wraps instead of widening its row. */
    overflow-wrap: break-word;
  }
  .adm *,
  .adm *::before,
  .adm *::after {
    box-sizing: border-box;
  }
  .adm :where(h1, h2, h3, h4, p, ul, ol, dl, dd, figure) {
    margin: 0;
  }
  .adm :where(ul, ol) {
    padding: 0;
    list-style: none;
  }
  .adm :where(input, select, textarea, button) {
    font: inherit;
    color: inherit;
  }
  .adm :where(button) {
    cursor: pointer;
  }
  .adm a {
    color: var(--brand-ink);
  }
  /* Headings speak in the shop's voice: Saira, condensed, set tight. */
  .adm :where(h1, h2, h3) {
    font-family: var(--font-display);
    font-weight: 650;
    font-stretch: 88%;
    letter-spacing: -0.01em;
    line-height: 1.1;
  }
  /* Figures (times, counts, seats) in Saira too: it has true tabular numerals. */
  .adm :where(.adm-fig) {
    font-family: var(--font-display);
    font-stretch: 94%;
  }
  .adm :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    box-shadow: 0 0 0 4px var(--brand);
  }
  .adm [hidden] {
    display: none !important;
  }
  @media (prefers-reduced-motion: reduce) {
    .adm *,
    .adm *::before,
    .adm *::after {
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
      animation-delay: 0s !important;
    }
  }

  /* ---- auth states --------------------------------------------------------- */
  .adm [data-when] {
    display: none;
  }
  .adm[data-auth='pending'] [data-when='pending'],
  .adm[data-auth='out'] [data-when='out'] {
    display: block;
  }
  .adm[data-auth='in'] [data-when='in'] {
    display: flex;
  }
  .adm-loading {
    padding: 48px 20px;
    text-align: center;
    color: var(--ink-2);
  }
  .adm-signin-wrap {
    min-height: 100vh;
    min-height: 100dvh;
    background: var(--brand);
  }

  .adm-skip {
    position: absolute;
    left: 8px;
    top: -120px;
    z-index: 100;
    background: var(--surface);
    padding: 10px 14px;
    border-radius: var(--r-control);
    box-shadow: var(--shadow-login);
  }
  .adm-skip:focus {
    top: 8px;
  }
  .adm-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* ---- shell --------------------------------------------------------------- */
  .adm-app {
    min-height: 100vh;
    min-height: 100dvh;
  }
  .adm-side {
    flex: none;
    width: var(--side-w);
    background: var(--brand);
    color: var(--on-brand);
    padding: 22px 12px 14px;
    display: flex;
    flex-direction: column;
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100dvh;
  }
  .adm-brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    padding: 0 10px 22px;
    text-decoration: none;
    color: var(--on-brand);
  }
  .adm-brand img {
    width: 120px;
    height: auto;
    display: block;
  }
  .adm-brand-sub {
    font-size: 13px;
    color: var(--on-brand-2);
  }
  .adm-grouphead {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--on-brand-accent);
    padding: 6px 12px 8px;
  }
  .adm-nav {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .adm-nav-item {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding: 0 12px;
    border-radius: 999px;
    font-size: 16px;
    font-weight: 400;
    text-decoration: none;
    transition: background 0.2s var(--ease-out), color 0.2s var(--ease-out);
  }
  .adm .adm-nav-item {
    color: var(--on-brand-2);
  }
  .adm .adm-nav-item:hover {
    background: rgb(243 241 235 / 0.08);
    color: var(--on-brand);
  }
  /* You are here: the caramel of the site's "Book a table" button. */
  .adm .adm-nav-item[aria-current='page'] {
    background: var(--accent);
    color: var(--ink);
    font-weight: 550;
  }
  .adm-side :focus-visible {
    box-shadow: none;
    outline-color: var(--on-brand-accent);
  }
  .adm-nav-label {
    flex: 1;
  }
  .adm-badge {
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 700;
    color: var(--ink);
    background: var(--accent);
    border-radius: 999px;
    padding: 2px 7px;
    min-width: 20px;
    text-align: center;
  }
  .adm-side-foot {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 2px;
    border-top: 1px solid rgb(243 241 235 / 0.14);
    padding-top: 10px;
  }
  /* Current page's badge sits on caramel already: flip it to olive. */
  .adm-nav-item[aria-current='page'] .adm-badge {
    background: var(--brand);
    color: var(--on-brand);
  }
  .adm-side-link {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0 10px;
    border: 0;
    background: none;
    border-radius: 999px;
    font-size: 14px;
    text-align: left;
    text-decoration: none;
  }
  .adm .adm-side-link {
    color: var(--on-brand-2);
  }
  .adm .adm-side-link:hover {
    background: rgb(243 241 235 / 0.08);
    color: var(--on-brand);
  }
  .adm-mockflag {
    font-size: 12px;
    color: var(--warn-ink);
    background: var(--warn-wash);
    border-radius: 999px;
    padding: 2px 10px;
    margin: 6px 10px 0;
    align-self: flex-start;
  }

  .adm-col {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }
  .adm-head {
    display: flex;
    align-items: flex-end;
    gap: 18px;
    padding: 28px 28px 18px;
    min-height: 64px;
  }
  .adm-head-text {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    column-gap: 14px;
  }
  .adm-title {
    font-size: clamp(34px, 2.2vw + 18px, 48px);
    line-height: 1;
    font-weight: 650;
    letter-spacing: -0.015em;
  }
  .adm-sub {
    font-size: 16px;
    font-weight: 350;
    color: var(--ink-2);
  }
  /* Anything loading anywhere on the page: a caramel line runs along the header.
     (Pages mark what they're fetching with aria-busy.) */
  .adm-head {
    position: relative;
  }
  .adm:has(.adm-main [aria-busy='true']) .adm-head::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    height: 3px;
    width: 30%;
    border-radius: 999px;
    background: var(--accent);
    animation: adm-busy 1.1s var(--ease-out) infinite;
  }
  @keyframes adm-busy {
    from {
      transform: translateX(-100%);
    }
    to {
      transform: translateX(340%);
    }
  }
  .adm-col {
    overflow-x: clip;
  }
  .adm-head-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }
  .adm-head-signout {
    display: none;
  }
  .adm-main {
    flex: 1;
    padding: 8px 28px 48px;
    width: 100%;
    max-width: 1040px;
  }
  .adm-main--wide {
    max-width: none;
  }
  .adm-main:focus {
    outline: none;
  }
  .adm-tabs {
    display: none;
  }

  /* Phone: no sidebar, a bottom tab bar, sign-out moves to the header. */
  @media (max-width: 759.98px) {
    .adm-side {
      display: none;
    }
    .adm-head {
      padding: 18px 16px 12px;
      gap: 10px;
      flex-wrap: wrap;
      align-items: center;
      min-height: 56px;
    }
    .adm-title {
      font-size: 32px;
    }
    /* Title and its sentence get the full width; actions drop beneath. */
    .adm-head-text {
      flex-basis: 100%;
      flex-direction: column;
      row-gap: 4px;
    }
    .adm-head-actions {
      width: 100%;
      justify-content: space-between;
    }
    .adm-sub {
      font-size: 15px;
    }
    .adm-head-signout {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding: 0 4px;
      border: 0;
      background: none;
      font-size: 13px;
      color: var(--ink-2);
      text-decoration: underline;
    }
    .adm-main {
      padding: 16px 16px calc(var(--tabbar-h) + 28px + env(safe-area-inset-bottom));
    }
    .adm-tabs {
      display: grid;
      grid-template-columns: repeat(7, 1fr);
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 30;
      background: var(--brand);
      padding-bottom: env(safe-area-inset-bottom);
    }
    .adm-tab {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 2px;
      min-height: var(--tabbar-h);
      font-size: 11px;
      font-weight: 600;
      text-decoration: none;
    }
    .adm .adm-tab {
      color: var(--on-brand-2);
    }
    .adm .adm-tab[aria-current='page'] {
      color: var(--on-brand);
      font-weight: 600;
    }
    .adm-tab[aria-current='page'] .adm-tab-icon {
      background: var(--accent);
      color: var(--ink);
    }
    .adm-tabs :focus-visible {
      box-shadow: none;
      outline-color: var(--on-brand-accent);
      outline-offset: -4px;
    }
    .adm-tab[aria-current='page'] .adm-badge--dot {
      background: var(--on-brand);
    }
    .adm-tab-icon {
      position: relative;
      display: grid;
      place-items: center;
      width: 44px;
      height: 30px;
      border-radius: 999px;
    }
    .adm-badge--dot {
      position: absolute;
      top: -2px;
      right: 2px;
      font-size: 10px;
      padding: 1px 5px;
      min-width: 16px;
    }
  }
  @media print {
    .adm-side,
    .adm-tabs,
    .adm-head-actions,
    .adm-toasts,
    .adm-skip {
      display: none !important;
    }
    .adm-main {
      padding: 0;
      max-width: none;
    }
    .adm-head {
      padding: 0 0 8px;
    }
  }

  /* ---- toasts ------------------------------------------------------------- */
  .adm-toasts {
    position: fixed;
    left: calc(var(--side-w) + 16px); /* past the sidebar, clear of a drawer's buttons on the right */
    bottom: 16px;
    z-index: 60;
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-items: flex-start;
    pointer-events: none;
    max-width: min(440px, calc(100vw - 32px));
  }
  @media (max-width: 759.98px) {
    .adm-toasts {
      left: 16px;
      right: 16px;
      bottom: calc(var(--tabbar-h) + 12px + env(safe-area-inset-bottom));
      align-items: stretch;
    }
