---
// Photo library: drop zone, upload progress and the grid (filled by scripts/admin/library.ts).
---

<section class="ph-sec" id="library" aria-labelledby="ph-lib-t">
  <header class="ph-sec__head">
    <h2 id="ph-lib-t">Photo library</h2>
    <p class="ph-muted adm-fig" data-library-count></p>
  </header>
  <p class="ph-sec__lead">Every photo you upload lands here first. Give each one a short description: it is read aloud to people who can’t see it, and helps Google.</p>

  <div class="ph-drop" data-drop>
    <input class="adm-sr" type="file" accept="image/jpeg,image/png,image/webp" multiple tabindex="-1" aria-hidden="true" data-drop-input />
    <p class="ph-drop__big"><span class="ph-drop__mouse">Drag photos here</span><span class="ph-drop__touch">Add photos</span></p>
    <p class="ph-muted ph-drop__mouse">or</p>
    <button type="button" class="adm-btn ph-drop__btn" data-drop-pick>Choose photos…</button>
    <p class="ph-muted ph-drop__rule">JPEG, PNG or WebP, up to 15 MB each. Phone photos are fine as they are.</p>
  </div>
  <ul class="ph-uploads" data-uploads hidden aria-label="Uploads"></ul>

  <p class="ph-muted" data-library-empty hidden>No photos yet. Add a few above, then place them on the site.</p>
  <ul class="ph-lib" data-library tabindex="-1" aria-label="Photos in the library"></ul>
</section>
