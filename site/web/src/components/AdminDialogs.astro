---
// Modal dialogs for /admin: the library picker and the delete confirmation.
// Native <dialog>: focus stays inside while open, Esc closes.
---

<dialog class="ph-dlg ph-dlg--wide" data-picker aria-labelledby="ph-pick-t">
  <div class="ph-dlg__in">
    <header class="ph-dlg__head">
      <h2 id="ph-pick-t" data-picker-title>Choose a photo</h2>
      <button type="button" class="ph-icon" data-picker-close aria-label="Close without choosing">×</button>
    </header>
    <ul class="ph-picker" data-picker-grid></ul>
    <footer class="ph-dlg__foot">
      <p class="ph-muted adm-fig" data-picker-note aria-live="polite"></p>
      <button type="button" class="adm-btn" data-picker-ok hidden>Add photo</button>
    </footer>
  </div>
</dialog>

<dialog class="ph-dlg" data-delete-dialog aria-labelledby="ph-del-t">
  <div class="ph-dlg__in">
    <h2 id="ph-del-t" data-delete-title>Delete this photo?</h2>
    <div class="ph-dlg__body" data-delete-body></div>
    <p class="ph-status" role="status" data-delete-msg></p>
    <div class="ph-dlg__actions" data-delete-actions></div>
  </div>
</dialog>
