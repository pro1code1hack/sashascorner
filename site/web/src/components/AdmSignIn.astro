---
// The admin sign-in card: paper on the café's olive, the brand's caramel "Open".
// (Layout from design-system.md: login card, r24.)
// Behaviour lives in scripts/admin-core/shell.ts (initSignIn).
---

<main class="adm-signin" id="adm-signin-main">
  <form class="adm-signin-card" data-signin novalidate>
    <img class="adm-signin-logo" src="/brand/logo.svg" alt="Sasha's Corner" width="150" height="90" />
    <h1 class="adm-signin-title">Website admin</h1>
    <p class="adm-signin-lede">Bookings, messages, the menu and photos for the website.</p>
    <p class="adm-signin-note" data-signin-note role="status" hidden></p>

    <div class="adm-field">
      <label class="adm-label" for="adm-password">Password</label>
      <input
        class="adm-signin-input"
        id="adm-password"
        name="password"
        type="password"
        autocomplete="current-password"
        required
        autocapitalize="off"
        spellcheck="false"
      />
      <p class="adm-err" id="adm-signin-error" data-signin-error role="alert" hidden></p>
    </div>

    <button class="adm-btn adm-signin-btn" type="submit">Open</button>

    <p class="adm-signin-keep">
      You'll stay signed in on this device for 14 days. Use <strong>Sign out</strong> on a shared phone or till.
    </p>
    <p class="adm-hint" data-signin-mock hidden>Mock mode: any password works; "wrong" and "slow" show the errors.</p>
  </form>
</main>

<style>
  .adm-signin {
    min-height: 100vh;
    min-height: 100dvh;
    display: grid;
    place-items: center;
    padding: 24px 16px;
    background: var(--brand);
  }
  .adm-signin-card {
    width: 100%;
    max-width: 400px;
    background: var(--canvas);
    border-radius: var(--r-login);
    box-shadow: 0 24px 60px rgb(0 0 0 / 0.28);
    padding: 36px 32px 30px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    animation: adm-signin-in 0.6s var(--ease-out) both;
  }
  @keyframes adm-signin-in {
    from {
      opacity: 0;
      transform: translateY(14px) scale(0.98);
    }
  }
  .adm-signin-logo {
    width: 132px;
    height: auto;
    display: block;
  }
  .adm-signin-title {
    font-size: 44px;
    line-height: 1;
    letter-spacing: -0.015em;
    margin-top: 6px;
  }
  .adm-signin-lede {
    color: var(--ink-2);
    font-size: 16px;
    font-weight: 350;
    margin-top: -4px;
  }
  .adm-signin-note {
    font-size: 14px;
    background: var(--wash);
    border-radius: var(--r-control);
    padding: 8px 12px;
  }
  .adm-signin-input {
    width: 100%;
    height: 48px;
    padding: 0 14px;
    border-radius: var(--r-card);
    border: 1px solid var(--line-strong);
    font-size: 17px;
    outline: none;
    background: var(--surface);
  }
  .adm-signin-input:focus {
    border-color: var(--brand);
    box-shadow: 0 0 0 3px var(--accent-wash);
  }
  .adm-signin-input[aria-invalid='true'] {
    border-color: var(--alert);
  }
  .adm-signin-btn {
    width: 100%;
    min-height: 52px;
    font-size: 17px;
  }
  .adm-signin-keep {
    font-size: 13px;
    color: var(--ink-2);
  }
  @media (max-width: 420px) {
    .adm-signin-card {
      padding: 24px 20px;
    }
  }
</style>
