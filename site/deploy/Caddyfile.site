# Sasha's Corner public website -- a Caddy site block, imported by the ops Caddyfile:
#
#   import /srv/site/*.caddy
#
# (top level, outside the ops site block). The `site-static` service copies this file
# into the `site_static` volume as /srv/site/site.caddy, next to the build it serves,
# so the config and the HTML it points at always come from the same release. The
# import is a GLOB on purpose: with no site deployed it matches nothing and Caddy
# starts normally (a plain path would stop the ops dashboard from starting).
#
# SITE_DOMAIN comes from the repo-root .env (the caddy service reads it via env_file).
# Unset, it is sashascorner.co.uk -- which only works once that domain's DNS points at
# this box; until then Caddy retries the certificate quietly and the ops site is
# unaffected.

{$SITE_DOMAIN:sashascorner.co.uk} {
	encode zstd gzip

	# Sasha's Corner Rewards, the staff scanner's API and Apple Wallet's web service
	# live in cafeops, not the site API (docs/loyalty/CONTRACT.md §8). Path matchers
	# are more specific than /api/*, so Caddy tries these first whatever their order.
	# reverse_proxy sets X-Forwarded-Proto/-For/-Host itself; cafeops builds absolute
	# pass and wallet URLs from CAFEOPS_LOYALTY_PUBLIC_URL, not from these headers.
	# The .pkpass Content-Type (application/vnd.apple.pkpass) comes from the API.
	handle /api/loyalty/* {
		reverse_proxy api:8000
	}
	handle /api/staff/* {
		reverse_proxy api:8000
	}
	handle /wallet/apple/* {
		reverse_proxy api:8000
	}

	# The site API. Same origin as the pages, so no CORS in production.
	handle /api/* {
		# No header_up needed: with no `trusted_proxies` configured, Caddy ignores any
		# client-supplied X-Forwarded-For and sets it to the real peer address, which
		# is what sashasite's rate limit keys on (SITE_TRUST_PROXY=1).
		reverse_proxy site-api:8100
	}

	# One URL per page: /menu.html and /index.html are the files, /menu and / are
	# the canonical addresses. Redirect rather than serve the same page twice.
	redir /index.html / permanent
	@dothtml path_regexp dothtml ^(/.+)\.html$
	handle @dothtml {
		redir {re.dothtml.1} permanent
	}

	# Every web card, /c/<card id>, is the one static page c.html; its script reads the
	# id from the path and the token from the #fragment (which never reaches this log).
	handle /c/* {
		root * /srv/site/public
		rewrite * /c.html
		file_server
	}

	# The staff scanner: /staff is staff.html (found by try_files below); anything under
	# /staff/ that is not a real file (manifest, service worker, icons) is the same app.
	handle /staff/* {
		root * /srv/site/public
		try_files {path} /staff.html
		file_server
	}

	handle {
		root * /srv/site/public
		# Astro builds `build.format: 'file'` with `trailingSlash: 'never'`:
		# /menu is dist/menu.html, /book/manage is dist/book/manage.html.
		try_files {path} {path}.html {path}/index.html
		file_server
	}

	handle_errors 404 {
		root * /srv/site/public
		rewrite * /404.html
		file_server
	}

	# Astro content-hashes everything under /_astro/, so those URLs never change
	# contents: cache for a year. HTML names the current hashes, so it must be
	# revalidated or a deploy keeps serving the old page.
	@hashed path /_astro/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	@html {
		not path /_astro/* /api/* /wallet/* /staff /staff/*
		not path_regexp \.(png|jpe?g|webp|avif|svg|ico|woff2?|xml|txt|webmanifest|json)$
	}
	header @html Cache-Control "public, max-age=0, must-revalidate"

	# The scanner (page, manifest, service worker) is never cached: a till must pick up a
	# fix on its next load. The worker lives at /staff/sw.js but controls /staff itself,
	# which is outside its default scope (/staff/) without this header.
	@staff {
		path /staff /staff/*
		not path_regexp \.(png|svg|ico)$
	}
	header @staff Cache-Control "no-cache"
	header /staff/sw.js Service-Worker-Allowed /staff

	# Private pages: a card belongs to one person, the scanner to the staff.
	header /c/* X-Robots-Tag "noindex, nofollow"
	header /staff* X-Robots-Tag "noindex, nofollow"

	# Photos, icons, fonts, og.png, sitemap: not hashed, change rarely.
	@static {
		path_regexp \.(png|jpe?g|webp|avif|svg|ico|woff2?|webmanifest)$
		not path /stickers/*
		# The scanner's manifest is no-cache (below); without this both matched and the
		# week-long policy won, so a till kept a stale manifest.
		not path /staff/*.webmanifest
	}
	header @static Cache-Control "public, max-age=604800"

	# The stamp stickers (web card, /rewards sample card, scanner) are redrawn IN PLACE
	# under the same names (slot-1.svg ... reward.svg, copied from assets/pass/stickers by
	# `cafeops wallet assets`), so a week-long cache would show old art next to a wallet
	# pass that already has the new one. Revalidate every time: file_server's ETag turns
	# that into a tiny 304 until the art actually changes.
	# Caddy has no MIME type for .webmanifest and served the scanner's and the site's
	# manifests with none at all; the spec'd type keeps "install app" reliable.
	@manifest path *.webmanifest
	header @manifest Content-Type "application/manifest+json"

	@stickers path /stickers/*
	header @stickers Cache-Control "public, max-age=0, must-revalidate"

	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	log {
		output stdout
		format console
	}
}

# www -> apex, permanently.
www.{$SITE_DOMAIN:sashascorner.co.uk} {
	redir https://{$SITE_DOMAIN:sashascorner.co.uk}{uri} permanent
}
