<script>
  // Mark today's row in the hours table (Europe/London).
  const wd = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'].indexOf(
    new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/London', weekday: 'short' }).format(new Date()),
  );
  for (const tr of document.querySelectorAll<HTMLElement>('.visit__hours tr[data-days]')) {
    if ((tr.dataset.days ?? '').split(',').map(Number).includes(wd)) tr.classList.add('is-today');
  }

  // Build your drink. Every state is a drink on the board. Picking a base shows that
  // base's flavours and temperatures; picking an option that doesn't exist with the
  // current others keeps the choice and changes the others (temperature first, then
  // flavour, then base) until it names a real drink, and says what it changed.
  type Dim = 'base' | 'flavour' | 'temp';
  type State = Record<Dim, string>;
  type B = {
    combos: Record<string, { name: string; price: string }>;
    flavours: Record<string, string[]>;
    syrups: Record<string, string>;
    liquids: Record<string, string>;
    start: string;
  };
  const host = document.querySelector<HTMLElement>('[data-builder]');
  if (host) {
    const b: B = JSON.parse(host.dataset.builder ?? '{}');
    const card = host.querySelector<HTMLElement>('.builder__card')!;
    const note = host.querySelector<HTMLElement>('[data-note]')!;
    const dims: Dim[] = ['base', 'flavour', 'temp'];
    const prefer: Dim[] = ['temp', 'flavour', 'base'];
    const [base, flavour, temp] = b.start.split('|');
    let st: State = { base, flavour, temp };
    const key = (s: State) => `${s.base}|${s.flavour}|${s.temp}`;
    const values = (d: Dim, s: State): string[] =>
      d === 'base' ? Object.keys(b.flavours) : d === 'flavour' ? (b.flavours[s.base] ?? []) : ['iced', 'hot'];
    const label = (dim: Dim, v: string) =>
      host.querySelector<HTMLElement>(`[data-dim="${dim}"][data-val="${v}"]`)?.textContent?.trim().toLowerCase() ?? v;

    const resolve = (dim: Dim, v: string): State => {
      const want = { ...st, [dim]: v };
      if (b.combos[key(want)]) return want;
      const others = prefer.filter((d) => d !== dim);
      for (const d of others)
        for (const x of values(d, want)) {
          const s = { ...want, [d]: x };
          if (b.combos[key(s)]) return s;
        }
      for (const x of values(others[0], want)) {
        const s0 = { ...want, [others[0]]: x };
        for (const y of values(others[1], s0)) {
          const s = { ...s0, [others[1]]: y };
          if (b.combos[key(s)]) return s;
        }
      }
      return st;
    };

    const render = (changed: Dim[]) => {
      const c = b.combos[key(st)];
      if (!c) return;
      const temps = ['iced', 'hot'].filter((t) => Object.keys(b.combos).some((k) => k.startsWith(`${st.base}|`) && k.endsWith(`|${t}`)));
      for (const btn of host.querySelectorAll<HTMLButtonElement>('[data-dim]')) {
        const d = btn.dataset.dim as Dim;
        btn.setAttribute('aria-pressed', String(st[d] === btn.dataset.val));
        if (d === 'flavour') btn.hidden = !(b.flavours[st.base] ?? []).includes(btn.dataset.val!);
        if (d === 'temp') btn.hidden = !temps.includes(btn.dataset.val!);
      }
      card.dataset.base = st.base;
      card.dataset.temp = st.temp;
      card.dataset.flavour = st.flavour;
      card.querySelector('.cup__liquid')!.setAttribute('fill', b.liquids[st.base] ?? '#8aa35e');
      card.querySelector('.cup__syrup')!.setAttribute('fill', b.syrups[st.flavour] ?? 'transparent');
      host.querySelector('[data-name]')!.textContent = c.name;
      host.querySelector('[data-price]')!.textContent = c.price;
      note.hidden = changed.length === 0;
      note.textContent = changed.length
        ? `On the board that one comes ${changed.map((d) => label(d, st[d])).join(', ')}.`
        : '';
    };

    host.addEventListener('click', (e) => {
      const btn = (e.target as Element).closest<HTMLButtonElement>('[data-dim]');
      if (!btn) return;
      const dim = btn.dataset.dim as Dim;
      const next = resolve(dim, btn.dataset.val!);
      // A new base brings its own flavours, so a changed flavour there is expected,
      // not news; only a forced temperature is worth a line.
      const changed = dims.filter(
        (d) => d !== dim && next[d] !== st[d] && !(dim === 'base' && d === 'flavour'),
      );
      st = next;
      render(changed);
    });
  }
</script>

